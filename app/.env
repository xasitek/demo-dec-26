# =============================================================================
#  FINANCE CREANCES — DEMONSTRATION DEC
#  Copie independante, donnees 100 % synthetiques.
#  AUCUN secret de production. AUCUNE connexion a un systeme du groupe.
#  Toute action sortante (banque, messagerie, stockage, orchestration) est
#  neutralisee : voir NEUTRALISATION.md.
# =============================================================================

APP_ENV=demo
APP_DEBUG=0
APP_SECRET=demo-dec-secret-non-sensible-0000000000000000
DEFAULT_URI=http://localhost:8123

# --- Base de demonstration. Conteneur dedie, port 55432, jamais 5432.
#     Le PostgreSQL eventuellement present sur 5432 n'est PAS touche.
POSTGRES_DB=finance_demo
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo
DATABASE_URL="postgresql://demo:demo@127.0.0.1:55432/finance_demo?serverVersion=16&charset=utf8"

# --- Miroir du progiciel comptable : AUCUN. La demonstration ne lit aucune
#     source externe ; ses tables miroir sont peuplees par la fabrique.
SAGE_DATABASE_URL=""

# --- Messagerie : transport nul. Rien ne sort, jamais.
MAILER_DSN=null://null
MAILER_COPILOTE_DSN=null://null
MAILER_FROM_EMAIL=demonstration@exemple.invalid
MAILER_FROM_NAME="Finance Creances - Demonstration"
MAIL_PASSTHROUGH=0
REMBOURSEMENT_FORCE_TO=demonstration@exemple.invalid
RECOUVREMENT_FORCE_TO=demonstration@exemple.invalid
RECOUVREMENT_FROM_EMAIL=demonstration@exemple.invalid
RECOUVREMENT_REPLY_TO=demonstration@exemple.invalid

# --- Courrier entrant : desactive.
IMAP_DSN=""
IMAP_HOST=""
IMAP_PORT=""
IMAP_USER=""
IMAP_PASS=""
IMAP_FOLDER=""
IMAP_FLAGS=""
RECOUVREMENT_POP3_HOST=""
RECOUVREMENT_POP3_PORT=""
RECOUVREMENT_POP3_USER=""
RECOUVREMENT_POP3_PASS=""

# --- Files de traitement : en base, aucun service externe.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
REDIS_URL=""

# --- Temps reel : desactive, la demonstration se rafraichit a la navigation.
MERCURE_URL=http://127.0.0.1:8123/demo/mercure
MERCURE_PUBLIC_URL=/demo/mercure
MERCURE_JWT_SECRET=demo-non-sensible

# --- Identite : aucune federation. Connexion par choix de profil synthetique.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
LIVRAISON_SERVICE_ACCOUNT_JSON=""

# --- Classeurs externes : aucun.
BONUS_ECO_SHEET_ID=""
BONUS_ECO_SHEET_GID=""
LIVRAISON_ESPACE_LIVREUR_SHEET_ID=""

# --- Jetons applicatifs : aucun.
GARANTIES_API_TOKEN=""

# --- Lecture des pieces : fournisseur SIMULE, resultats synthetiques prepares.
#     Aucune cle, aucun appel sortant. La chaine aval fonctionne entierement.
REMBOURSEMENT_OCR_PROVIDER=simule
GEMINI_API_KEY=""
GEMINI_MODELE=""

# --- Fusion de documents : optionnelle, repli gracieux si absente.
RECOUVREMENT_GS_BIN=""
RECOUVREMENT_PDF_QUOTA_OCTETS=52428800

# --- Variables attendues par certains services, neutralisees.
MAILER_RELANCES_DSN=null://null

# --- Porte d acces de la demonstration. Un seul compte, transmis
#     separement du lien. Le mot de passe n est pas stocke : seule son
#     empreinte l est.
# PORTE D'ACCES DE L'APPLICATION.
#
# L'empreinte du mot de passe est VOLONTAIREMENT VIDE ici : ce depot est
# public, et y ecrire le condensat reviendrait a publier le mot de passe.
# Elle se pose en variable d'environnement sur l'hebergeur. Pour la
# fabriquer :
#   php -r 'echo base64_encode(password_hash("VOTRE-MOT-DE-PASSE", PASSWORD_BCRYPT));'
# Vide, la porte refuse tout le monde -- ce qui est le bon comportement par
# defaut si quelqu'un deploie cette copie sans y penser.
DEMO_ACCES_IDENTIFIANT=jury
DEMO_ACCES_EMPREINTE_B64=
DEMO_ACCES_DUREE_MINUTES=480

# Compteur de visites : la clef de l'ecran /demo/visites/<clef>.
# Videe, l'ecran devient inaccessible. A remplacer par une variable
# d'environnement sur l'hebergeur plutot que de la laisser ici.
DEMO_VISITES_CLE=
