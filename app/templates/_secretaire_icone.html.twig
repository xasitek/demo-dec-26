{# Icones des espaces du poste secretaire.

   Les SVG vivent ici et non en PHP : un espace declare une cle d'icone, ce gabarit
   la resout. Trait 1.8px, style Lucide, comme le reste de la barre laterale.
   Regle du projet : jamais d'emoji, uniquement du SVG.

   Param : icone (cle declaree par l'espace). #}
{% if icone == 'colis' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10h18M3 10l1-4a2 2 0 0 1 2-1.5h12A2 2 0 0 1 20 6l1 4M3 10v8a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-8"/><path d="M14 15l-2 2-2-2M12 17V11"/></svg>
{% elseif icone == 'camion' %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6.5h10.5a1 1 0 0 1 1 1V16H3a1 1 0 0 1-1-1V7.5a1 1 0 0 1 1-1z"/><path d="M14.5 10H18l3 3v3h-6.5"/><circle cx="7" cy="18" r="1.9"/><circle cx="17" cy="18" r="1.9"/><path d="M9 18h6"/></svg>
{% else %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 12h6"/></svg>
{% endif %}
