{% extends 'layout.html.twig' %}

{% set id = fiche.identite %}
{% set e = fiche.encours %}

{% block title %}{{ id.raison_sociale }} - Fiche client - Recouvrement{% endblock %}
{% block page_title %}Recouvrement{% endblock %}
{% block topbar_nav %}{% include 'recouvrement/_topbar_nav.html.twig' with {active: 'relancer'} %}{% endblock %}

{% macro euros(v) %}{{ v|number_format(2, ',', ' ') }} €{% endmacro %}

{% block content %}
{% import _self as f %}
<div class="mx-auto w-full max-w-[100rem] px-3 pb-10"
     data-controller="relance-manuelle curation apercu-drawer"
     data-relance-manuelle-envoyer-url-value="{{ path('app_recouvrement_relancer_envoyer') }}"
     data-relance-manuelle-factures-url-value="{{ path('app_recouvrement_relancer_factures', {compte: '__COMPTE__'}) }}"
     data-relance-manuelle-csrf-value="{{ csrf_token('relancer-manuel') }}"
     data-curation-decider-url-value="{{ path('app_recouvrement_curation_decider') }}"
     data-curation-csrf-value="{{ csrf_token('curation-decider') }}">

    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-sm">
            <a href="{{ path('app_recouvrement_relancer') }}" class="text-ink/55 hover:text-navy">Clients</a>
            <span class="text-ink/30">/</span>
            <span class="font-medium text-navy">{{ id.raison_sociale }}</span>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button" data-action="relance-manuelle#relancerClient" data-compte="{{ fiche.compte }}" data-niveau="1"
                    class="inline-flex items-center gap-1.5 rounded-md bg-navy px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-navy-light">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
                Relance 1
            </button>
            <button type="button" data-action="relance-manuelle#relancerClient" data-compte="{{ fiche.compte }}" data-niveau="2"
                    class="inline-flex items-center gap-1.5 rounded-md border border-navy/30 bg-white px-3 py-1.5 text-sm font-semibold text-navy transition hover:bg-navy/5">
                Relance 2
            </button>
            <button type="button" data-action="relance-manuelle#relancerClient" data-compte="{{ fiche.compte }}" data-niveau="med"
                    class="inline-flex items-center gap-1.5 rounded-md border border-negative/40 bg-white px-3 py-1.5 text-sm font-semibold text-negative transition hover:bg-negative/10">
                Mise en demeure
            </button>
            <button type="button" data-action="curation#basculer" data-compte="{{ fiche.compte }}" data-ecarte="{{ fiche.ecarte ? '1' : '0' }}"
                    class="curation-statut inline-flex items-center justify-center gap-1.5 rounded-md border px-3 py-1.5 text-sm font-semibold transition {{ fiche.ecarte ? 'border-negative/40 text-negative hover:bg-negative/10' : 'border-positive/40 text-positive hover:bg-positive/10' }}"
                    title="{{ fiche.ecarte ? 'Écarté — cliquer pour réintégrer' : 'Relançable — cliquer pour écarter' }}">
                {% if fiche.ecarte %}
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    Réintégrer
                {% else %}
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                    Écarter
                {% endif %}
            </button>
            <button type="button" data-action="apercu-drawer#montrer"
                    class="inline-flex items-center gap-1.5 rounded-md border border-hairline bg-white px-3 py-1.5 text-sm font-medium text-ink/70 transition hover:border-navy hover:text-navy">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v5h5"/><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"/><path d="M12 7v5l4 2"/></svg>
                Historique
            </button>
        </div>
    </div>

    {# En-tete identite #}
    <div class="rounded-lg border border-hairline bg-white p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="min-w-0">
                <h1 class="text-xl font-bold text-navy">{{ id.raison_sociale }}</h1>
                <div class="mt-1 text-sm text-ink/60">
                    Compte <span class="font-semibold text-ink/80">{{ fiche.compte }}</span>
                    {# Multi-sites : on annonce le nombre plutot qu'un etablissement arbitraire. #}
                    {% if e.nb_societes == 1 and e.code_entite %} · {{ e.code_entite }}
                    {% elseif e.nb_societes > 1 %} · {{ e.nb_societes }} sociétés
                    {% endif %}
                    {% if e.nb_etab == 1 and e.codeetab %} · {{ e.codeetab|etablissement }}
                    {% elseif e.nb_etab > 1 %} · {{ e.nb_etab }} établissements
                    {% endif %}
                    {% if e.marque %} · {{ e.marque }}{% endif %}
                </div>
                <div class="mt-2 flex flex-wrap gap-1.5">
                    {% if id.famille %}<span class="inline-flex items-center rounded-full bg-navy/5 px-2.5 py-0.5 text-xs font-medium text-navy">{{ id.famille.code }} — {{ id.famille.libelle }}</span>{% endif %}
                    {% if id.statut_juridique %}<span class="inline-flex items-center rounded-full bg-navy/5 px-2.5 py-0.5 text-xs font-medium text-navy">{{ id.statut_juridique }}</span>{% endif %}
                    {% if id.bloque %}<span class="inline-flex items-center rounded-full bg-negative/10 px-2.5 py-0.5 text-xs font-semibold text-negative">Compte bloqué</span>{% endif %}
                </div>
            </div>
            <div class="shrink-0 text-right text-sm">
                {% if id.plafond %}
                    <div class="text-xs uppercase tracking-wide text-ink/45">Limite de crédit</div>
                    <div class="text-lg font-bold text-navy">{{ f.euros(id.plafond) }}</div>
                {% endif %}
                {% if id.siren %}<div class="mt-1 text-xs text-ink/55">SIREN {{ id.siren }}</div>{% endif %}
                {% if id.tva %}<div class="text-xs text-ink/55">TVA {{ id.tva }}</div>{% endif %}
            </div>
        </div>

        {# Coordonnees + reglement #}
        <div class="mt-4 grid grid-cols-1 gap-4 border-t border-hairline pt-4 sm:grid-cols-3">
            <div>
                <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-ink/45">Coordonnées</div>
                {% if id.adresse is not empty %}<div class="text-sm text-ink/80">{{ id.adresse|join(', ') }}</div>{% endif %}
                <div class="mt-1 flex flex-wrap gap-2 text-sm">
                    {% if id.email %}<a href="mailto:{{ id.email }}" class="text-navy hover:underline">{{ id.email }}</a>{% endif %}
                    {% if id.telephone %}<a href="tel:{{ id.telephone }}" class="text-navy hover:underline">{{ id.telephone }}</a>{% endif %}
                    {% if id.portable %}<a href="tel:{{ id.portable }}" class="text-navy hover:underline">{{ id.portable }}</a>{% endif %}
                </div>
            </div>
            <div>
                <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-ink/45">Règlement</div>
                {% if id.conditions %}<div class="text-sm text-ink/80">{{ id.conditions.libelle }}</div>{% endif %}
                {% if id.mode_paiement %}<div class="text-sm text-ink/60">{{ id.mode_paiement.libelle }}</div>{% endif %}
                {% if id.iban %}<div class="mt-1 text-xs text-ink/50">{{ id.iban }}{% if id.bic %} · {{ id.bic }}{% endif %}</div>{% endif %}
            </div>
            <div>
                <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-ink/45">Ancienneté des créances</div>
                {% if e.creance_ancienne %}<div class="text-sm text-ink/80">Plus ancienne : {{ e.creance_ancienne|date('d/m/Y') }}</div>{% endif %}
                {% if e.creance_recente %}<div class="text-sm text-ink/60">Plus récente : {{ e.creance_recente|date('d/m/Y') }}</div>{% endif %}
                {% if not e.creance_ancienne %}<div class="text-sm text-ink/40">—</div>{% endif %}
            </div>
        </div>
    </div>

    {# Bandeau encours : buckets de retard #}
    <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-5">
        <div class="rounded-lg border border-navy/15 bg-navy/[0.03] p-3">
            <div class="text-xs text-ink/55">Encours total ({{ e.nb }})</div>
            <div class="text-base font-bold text-navy">{{ f.euros(e.total) }}</div>
        </div>
        <div class="rounded-lg border border-hairline bg-white p-3">
            <div class="text-xs text-ink/55">À échoir</div>
            <div class="text-base font-semibold text-ink/80">{{ f.euros(e.a_echoir) }}</div>
        </div>
        <div class="rounded-lg border border-hairline bg-white p-3">
            <div class="text-xs text-ink/55">Échu</div>
            <div class="text-base font-semibold text-negative">{{ f.euros(e.echu) }}</div>
        </div>
        <div class="rounded-lg border border-hairline bg-white p-3">
            <div class="text-xs text-ink/55">0 - 30 j</div>
            <div class="text-base font-semibold text-ink/80">{{ f.euros(e.b_0_30) }}</div>
        </div>
        <div class="rounded-lg border border-hairline bg-white p-3">
            <div class="text-xs text-ink/55">&gt; 30 j (retard max {{ e.retard_max }} j)</div>
            <div class="text-base font-semibold text-negative">{{ f.euros(e.b_30_plus) }}</div>
        </div>
    </div>

    {# Ecritures : scroll infini + tri par colonne (clic sur l'en-tete) #}
    {% set entetes = [
        {cle: 'libelle', label: 'Libellé', classe: ''},
        {cle: 'echeance', label: 'Échéance', classe: ''},
        {cle: 'retard', label: 'Retard', classe: 'text-right'},
        {cle: 'montant', label: 'Montant dû', classe: 'text-right whitespace-nowrap'},
    ] %}
    <div class="mt-5 rounded-lg border border-hairline bg-white p-4"
         data-controller="infinite-scroll"
         data-infinite-scroll-url-value="{{ path('app_recouvrement_fiche_ecritures', {compte: fiche.compte, tri: tri, etab: etab, soc: soc}) }}"
         data-infinite-scroll-page-value="1"
         data-infinite-scroll-total-pages-value="{{ total_pages }}">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-sm font-semibold text-navy">Écritures ({{ total_ecritures }})</h2>
            {# Deux filtres distincts : societe (code_entite) et etablissement (codeetab).
               Chacun ne s'affiche que si le compte a effectivement le choix. #}
            {% if societes|length > 1 or etablissements|length > 1 %}
                <form method="get" action="{{ path('app_recouvrement_fiche_client', {compte: fiche.compte}) }}" class="flex flex-wrap items-center gap-2">
                    {% if tri != 'echeance' %}<input type="hidden" name="tri" value="{{ tri }}">{% endif %}
                    {% if societes|length > 1 %}
                        <label class="text-xs font-medium text-ink/50">Société</label>
                        {# Changer de societe remet l'etablissement a zero : sinon un couple
                           societe/etablissement incoherent ne renverrait aucune ecriture. #}
                        <select name="soc" onchange="if (this.form.etab) { this.form.etab.value = ''; } this.form.submit()" class="fc-input text-xs">
                            <option value="">Toutes ({{ societes|length }})</option>
                            {% for s in societes %}<option value="{{ s }}" {{ soc == s ? 'selected' : '' }}>{{ s }}</option>{% endfor %}
                        </select>
                    {% elseif soc != '' %}
                        <input type="hidden" name="soc" value="{{ soc }}">
                    {% endif %}
                    {% if etablissements|length > 1 %}
                        <label class="text-xs font-medium text-ink/50">Établissement</label>
                        <select name="etab" onchange="this.form.submit()" class="fc-input text-xs">
                            <option value="">Tous ({{ etablissements|length }})</option>
                            {% for et in etablissements %}<option value="{{ et.code }}" {{ etab == et.code ? 'selected' : '' }}>{{ et.libelle }}</option>{% endfor %}
                        </select>
                    {% endif %}
                    {% if etab != '' or soc != '' %}<a href="{{ path('app_recouvrement_fiche_client', {compte: fiche.compte, tri: tri}) }}" class="text-xs text-ink/55 hover:text-navy" title="Réinitialiser les filtres">×</a>{% endif %}
                </form>
            {% endif %}
        </div>
        <div class="overflow-x-auto">
            <table class="w-full min-w-[1200px] text-sm">
                <thead>
                    <tr class="border-b border-hairline text-left text-xs uppercase tracking-wide text-ink/45">
                        <th class="py-2 pr-3">Pièce</th>
                        <th class="py-2 pr-3">Société / Établissement</th>
                        {% for en in entetes %}
                            <th class="py-2 pr-3 {{ en.classe }}">
                                <a href="{{ path('app_recouvrement_fiche_client', {compte: fiche.compte, tri: en.cle, etab: etab, soc: soc}) }}"
                                   class="inline-flex items-center gap-1 transition hover:text-navy {{ tri == en.cle ? 'text-navy' : '' }}">
                                    {{ en.label }}
                                    {% if tri == en.cle %}<svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>{% endif %}
                                </a>
                            </th>
                        {% endfor %}
                        <th class="py-2 pr-3">Type</th>
                        <th class="py-2 pr-3">Statut</th>
                        <th class="py-2 pr-3 text-center">PDF</th>
                        <th class="py-2"></th>
                    </tr>
                </thead>
                <tbody data-infinite-scroll-target="items">
                    {% include 'recouvrement/_fiche_ecritures.html.twig' with {compte: fiche.compte} %}
                </tbody>
            </table>
        </div>
        <div data-infinite-scroll-target="sentinel" class="h-px"></div>
        <p data-infinite-scroll-target="loading" class="py-3 text-center text-sm text-ink/50" style="display:none">Chargement...</p>
    </div>

    {# Historique des echanges : panneau lateral, ouvert par le bouton "Historique" #}
    <div data-apercu-drawer-target="backdrop" data-action="click->apercu-drawer#fermer" class="fixed inset-0 z-[55] hidden bg-navy-deep/30"></div>
    <aside data-apercu-drawer-target="panel" class="fixed right-0 top-0 z-[56] h-full w-full max-w-md translate-x-full overflow-y-auto bg-white shadow-2xl shadow-navy/30 transition-transform duration-200">
        <div class="flex items-center justify-between border-b border-hairline px-4 py-3">
            <span class="text-sm font-semibold text-navy">Historique des échanges</span>
            <button type="button" data-action="apercu-drawer#fermer" class="rounded p-1 text-ink/50 transition hover:bg-surface hover:text-navy" aria-label="Fermer">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </div>
        <div data-apercu-drawer-target="contenu" class="p-4">
        {% if fiche.timeline is empty %}
            <p class="py-4 text-center text-ink/45">Aucun échange enregistré pour ce compte.</p>
        {% else %}
            <ol class="relative ml-2 border-l border-hairline">
                {% for item in fiche.timeline %}
                    <li class="mb-4 ml-4">
                        {% if item.type == 'relance' %}
                            <span class="absolute -left-1.5 mt-1 h-3 w-3 rounded-full bg-navy"></span>
                            <div class="text-xs text-ink/45">{{ item.date|date('d/m/Y H:i') }}</div>
                            <div class="text-sm font-medium text-navy">
                                {{ item.relance.miseEnDemeure ? 'Mise en demeure' : 'Relance' }} · niveau {{ item.relance.niveau }} · {{ item.relance.vecteur.value }}
                            </div>
                            <div class="text-sm text-ink/70">
                                {{ f.euros(item.relance.montantSolde) }}
                                {% if item.relance.destinataire %} → {{ item.relance.destinataire }}{% endif %}
                                {% if item.relance.statut %} · {{ item.relance.statut.value }}{% endif %}
                            </div>
                        {% elseif item.type == 'retour' %}
                            <span class="absolute -left-1.5 mt-1 h-3 w-3 rounded-full bg-gold"></span>
                            <div class="text-xs text-ink/45">{{ item.date|date('d/m/Y H:i') }}</div>
                            <div class="text-sm font-medium text-gold-dark">Réponse du client{% if item.retour.expediteur %} · {{ item.retour.expediteur }}{% endif %}</div>
                            {% if item.retour.sujet %}<div class="text-sm text-ink/70">{{ item.retour.sujet }}</div>{% endif %}
                            {% if item.retour.corpsTexte %}<div class="mt-1 line-clamp-3 whitespace-pre-line text-sm text-ink/60">{{ item.retour.corpsTexte }}</div>{% endif %}
                            {% if item.pieces is not empty %}<div class="mt-1 text-xs text-ink/50">{{ item.pieces|length }} pièce(s) jointe(s)</div>{% endif %}
                        {% else %}
                            <span class="absolute -left-1.5 mt-1 h-3 w-3 rounded-full bg-positive"></span>
                            <div class="text-xs text-ink/45">{{ item.date|date('d/m/Y H:i') }}</div>
                            <div class="text-sm font-medium text-positive">Réponse envoyée{% if item.message.auteur %} · {{ item.message.auteur }}{% endif %}</div>
                            {% if item.message.sujet %}<div class="text-sm text-ink/70">{{ item.message.sujet }}</div>{% endif %}
                        {% endif %}
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
        </div>
    </aside>

    {# Piles de toasts (retours d'envoi relance / curation) #}
    <div data-relance-manuelle-target="toasts" class="fixed bottom-5 right-5 z-50 flex w-80 flex-col gap-2"></div>
    <div data-curation-target="toasts" class="fixed bottom-5 left-5 z-50 flex w-80 flex-col gap-2"></div>

</div>
{% endblock %}
