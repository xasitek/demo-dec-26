{# Carte de progression (bas-droite) d'un lancement manuel de strategie. Masquee
   par defaut ; le controleur Stimulus "preparation" l'affiche au chargement s'il
   y a un run en cours, puis la met a jour en temps reel (Mercure) et la masque a
   la fin. Persistante : presente sur toutes les pages du module. #}
<div data-controller="preparation"
     data-preparation-etat-url-value="{{ path('app_recouvrement_preparation_etat') }}"
     data-preparation-target="card"
     {# bottom-20 : le coin bas-droite est occupe par l'ampoule de la boite a idees
        (cf. _suggestion_ampoule.html.twig), la carte se pose juste au-dessus. #}
     class="fixed bottom-20 right-4 z-50 hidden w-80 max-w-[calc(100vw-2rem)] rounded-xl border border-hairline bg-white shadow-xl"
     role="status" aria-live="polite">
    <div class="flex items-start gap-3 p-4">
        <span data-preparation-target="spinner" class="mt-0.5 shrink-0 text-navy">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="h-5 w-5 animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        </span>
        <span data-preparation-target="check" class="mt-0.5 hidden shrink-0 text-positive">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-navy" data-preparation-target="title">Lancement en cours</p>
            <p class="mt-0.5 text-xs text-ink/55" data-preparation-target="detail">Préparation des relances…</p>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-surface">
                <div data-preparation-target="bar" class="h-full rounded-full bg-navy transition-all duration-300" style="width:0%"></div>
            </div>
        </div>
        <button type="button" data-action="preparation#fermer" data-preparation-target="close" class="hidden shrink-0 text-ink/40 hover:text-navy" aria-label="Fermer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4 w-4"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
    </div>
</div>
