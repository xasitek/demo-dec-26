{# Lignes du tableau "factures sans PDF". Partage entre le rendu initial et le
   rechargement en direct (fragment). Attend : factures (list). #}
{% for f in factures %}
    <tr data-ecriture="{{ f.ecriture_id }}" class="border-t border-hairline align-top transition hover:bg-surface">
        <td class="whitespace-nowrap px-3 py-2 font-mono text-xs text-ink/70">{{ f.journal }}</td>
        <td class="whitespace-nowrap px-3 py-2 font-mono text-xs">{{ f.numpiece ?: f.reference_facture ?: '—' }}</td>
        <td class="px-3 py-2">
            <span class="font-semibold text-navy">{{ f.raison_sociale ?: (f.nom ~ ' ' ~ f.prenom)|trim ?: f.compte }}</span>
            <span class="block font-mono text-[0.7rem] text-ink/45">{{ f.compte }}</span>
        </td>
        <td class="whitespace-nowrap px-3 py-2">{{ f.date_echeance ? f.date_echeance|date('d/m/Y') : '—' }}</td>
        <td class="whitespace-nowrap px-3 py-2">{{ f.jours_retard }} j</td>
        <td class="whitespace-nowrap px-3 py-2 text-right font-semibold text-navy">{{ f.montant_solde|number_format(2, ',', ' ') }} €</td>
        <td class="whitespace-nowrap px-3 py-2">
            <form enctype="multipart/form-data" data-action="submit->factures-sans-pdf#empecherSubmit">
                <label class="inline-flex cursor-pointer items-center gap-1.5 rounded-md border border-navy/25 bg-white px-3 py-1.5 text-xs font-semibold text-navy transition hover:bg-navy hover:text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
                    Téléverser
                    <input type="file" name="fichier" accept="application/pdf,.pdf" class="hidden" data-action="change->factures-sans-pdf#uploader">
                </label>
                <span class="ml-2 text-xs text-ink/60" data-role="etat"></span>
            </form>
        </td>
    </tr>
{% endfor %}
