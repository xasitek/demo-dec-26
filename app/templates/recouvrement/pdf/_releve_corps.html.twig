{#
    Corps du RELEVE (document PDF) : un bloc par etablissement (compte bancaire SYNTHAUTO)
    = tableau ALLEGE des factures + CARTE RIB mise en avant (montant, IBAN/BIC, ref)
    avec QR virement SEPA a cote. Puis TOTAL GENERAL (net des avoirs).

    Partiel DEDIE au PDF (dompdf) : styles inline, tables (pas de flex/grid), aucun
    residu responsive d'e-mail. Ne pas mutualiser avec le corps d'e-mail.

    Attend : groupe (GroupeARelancer). Colonne "Immat. / OR" affichee si au moins
    une facture porte une immat ou un OR (numor '0'/'' = absent), sinon masquee.
#}
{% set navy = '#2D3250' %}
{% set gold = '#C8AA73' %}
{% set hair = '#F0F0F3' %}
{% set muted = '#9096a6' %}

{% set has_id = groupe.factures|default([])|filter(f => (f.numimmat|default('')|trim) is not empty or (f.numor|default('')|trim not in ['', '0']))|length > 0 %}
{% set ncol = has_id ? 5 : 4 %}
{% set plusieurs = groupe.releve|default([])|length > 1 %}

{% for g in groupe.releve|default([]) %}
    {# Bloc etablissement insecable : part entier a la page suivante s'il ne tient pas. #}
    <div style="page-break-inside: avoid; margin-top: 22px;">
        <div style="font-size: 13px; font-weight: bold; color: {{ navy }}; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 2px solid {{ navy }}; padding-bottom: 5px;">
            {{ g.titulaire ?: 'Autres factures' }}
        </div>

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; font-size: 12.5px; margin-top: 2px;">
            <thead>
                <tr>
                    <th align="left" style="padding: 8px 8px 6px; color: {{ muted }}; font-weight: 600; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid #DADCE3;">Facture</th>
                    <th align="left" style="padding: 8px 8px 6px; color: {{ muted }}; font-weight: 600; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid #DADCE3;">Échéance</th>
                    <th align="left" style="padding: 8px 8px 6px; color: {{ muted }}; font-weight: 600; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid #DADCE3;">Retard</th>
                    {% if has_id %}<th align="left" style="padding: 8px 8px 6px; color: {{ muted }}; font-weight: 600; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid #DADCE3;">Immat. / OR</th>{% endif %}
                    <th align="right" style="padding: 8px 8px 6px; color: {{ muted }}; font-weight: 600; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid #DADCE3;">Montant TTC</th>
                </tr>
            </thead>
            <tbody>
                {% for facture in g.factures %}
                    {% set immat = facture.numimmat|default('')|trim %}
                    {% set oref = facture.numor|default('')|trim %}
                    {% if oref in ['', '0'] %}{% set oref = '' %}{% endif %}
                    <tr>
                        <td style="padding: 9px 8px; border-bottom: 1px solid {{ hair }}; font-family: 'Courier New', monospace; color: {{ navy }};">{{ facture.reference ?: facture.numpiece ?: '—' }}</td>
                        <td style="padding: 9px 8px; border-bottom: 1px solid {{ hair }};">{{ facture.date_echeance ? facture.date_echeance|date('d/m/Y') : '—' }}</td>
                        <td style="padding: 9px 8px; border-bottom: 1px solid {{ hair }}; white-space: nowrap;">{% if facture.montant < 0 %}—{% elseif facture.jours_retard > 0 %}{{ facture.jours_retard }} j{% else %}—{% endif %}</td>
                        {% if has_id %}<td style="padding: 9px 8px; border-bottom: 1px solid {{ hair }}; font-family: 'Courier New', monospace; white-space: nowrap;">{{ immat }}{% if immat and oref %} &middot; {% endif %}{% if oref %}OR {{ oref }}{% endif %}{% if not immat and not oref %}—{% endif %}</td>{% endif %}
                        <td align="right" style="padding: 9px 8px; border-bottom: 1px solid {{ hair }}; white-space: nowrap;{% if facture.montant < 0 %} color: #2E7D5F;{% endif %}">{{ facture.montant|number_format(2, ',', ' ') }} €</td>
                    </tr>
                {% endfor %}
                {% if plusieurs %}
                    <tr>
                        <td colspan="{{ ncol - 1 }}" align="right" style="padding: 10px 8px 0; color: {{ navy }}; font-weight: bold;">Sous-total établissement</td>
                        <td align="right" style="padding: 10px 8px 0; color: {{ navy }}; font-weight: bold; white-space: nowrap;">{{ g.montant|number_format(2, ',', ' ') }} €</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>

        {# CARTE RIB (le heros) : montant + IBAN/BIC + reference, QR SEPA a cote. #}
        {% if g.iban and g.montant > 0 %}
            {% set qr = sepa_qr(g.iban, g.bic, g.titulaire ?: 'GROUPE SYNTHAUTO', g.montant, 'Ref ' ~ groupe.compte_code) %}
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; margin: 10px 0 4px;">
                <tr>
                    <td style="background-color: #FBEED6; border-left: 4px solid {{ gold }}; padding: 14px 16px; vertical-align: middle;">
                        <div style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: #9a8a63;">À régler sur ce compte</div>
                        <div style="font-size: 20px; font-weight: bold; color: {{ navy }}; margin: 1px 0 8px;">{{ g.montant|number_format(2, ',', ' ') }} €</div>
                        <div style="font-family: 'Courier New', monospace; font-size: 14px; color: {{ navy }}; font-weight: bold; letter-spacing: 0.5px;">IBAN : {{ g.iban }}</div>
                        <div style="font-family: 'Courier New', monospace; font-size: 12px; color: #555555; margin-top: 2px;">{% if g.bic %}BIC : {{ g.bic }} &middot; {% endif %}Réf. à indiquer : [{{ groupe.compte_code }}]</div>
                        <div style="font-size: 11px; color: #6a5a30; margin-top: 6px;">Titulaire : {{ g.titulaire ?: '—' }}</div>
                    </td>
                    {% if qr %}
                        <td style="width: 118px; text-align: center; vertical-align: middle; background-color: #FBEED6; padding: 10px;">
                            <div style="background-color: #FFFFFF; border: 1px solid #E6D9B8; padding: 6px; display: inline-block;">
                                <img src="{{ qr }}" alt="QR virement SEPA" width="96" height="96" style="display: block;">
                            </div>
                            <div style="font-size: 8.5px; color: #9a8a63; margin-top: 5px; line-height: 1.3;">Scannez pour virer<br>depuis votre appli bancaire</div>
                        </td>
                    {% endif %}
                </tr>
            </table>
        {% endif %}
    </div>
{% endfor %}

{# TOTAL GENERAL (net des avoirs). #}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; margin: 20px 0 6px; page-break-inside: avoid;">
    <tr>
        <td align="right" style="width: 70%; padding: 11px 14px; background-color: {{ navy }}; color: #FFFFFF; font-weight: bold; letter-spacing: 0.03em;">Total général restant dû</td>
        <td align="right" style="padding: 11px 14px; background-color: #E5D4B0; color: {{ navy }}; font-weight: bold; font-size: 17px; white-space: nowrap;">{{ groupe.total|number_format(2, ',', ' ') }} € TTC</td>
    </tr>
</table>
