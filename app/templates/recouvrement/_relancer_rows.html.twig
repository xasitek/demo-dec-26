{# Lignes de la vue CLIENTS (rendu seul pour le scroll infini, ou inclus dans la page).
   Attend : comptes (list depuis mv_annuaire_clients : {compte, client, email, telephone,
   siren, ville, encours, echu, retard_max, nb_factures, codeetab, collectif,
   niveau_max_envoye, ecarte}). Le nom = lien vers la fiche (action primaire) ; le statut
   (curation) et Relancer (relance-manuelle) sont secondaires en fin de ligne. #}
{% for c in comptes %}
    <tr data-relance-manuelle-target="clientRow" data-compte="{{ c.compte }}" class="{{ c.ecarte ? 'bg-negative/[0.03]' : '' }}">
        <td>
            <a href="{{ path('app_recouvrement_fiche_client', {compte: c.compte}) }}" class="font-medium text-navy hover:underline">{{ c.client }}</a>
            <div class="text-xs text-ink/50">
                {{ c.compte }}{% if c.ville %} · {{ c.ville }}{% endif %}{% if c.email %} · {{ c.email }}{% endif %}
            </div>
        </td>
        <td class="fc-cell-fit whitespace-nowrap text-right">
            <span class="font-medium text-navy">{{ c.encours|number_format(0, ',', ' ') }} €</span>
            {% if c.echu > 0 %}<span class="block text-[0.65rem] font-normal text-negative">échu {{ c.echu|number_format(0, ',', ' ') }} €</span>{% endif %}
        </td>
        <td class="fc-cell-fit whitespace-nowrap text-xs text-ink/70">{{ c.retard_max > 0 ? c.retard_max ~ ' j' : '—' }}</td>
        <td class="fc-cell-fit whitespace-nowrap text-xs">
            {% if c.niveau_max_envoye %}
                <span class="inline-flex rounded-full bg-surface px-2 py-0.5 font-medium text-ink/60">Niveau {{ c.niveau_max_envoye }}</span>
            {% else %}
                <span class="text-ink/40">—</span>
            {% endif %}
        </td>
        <td class="fc-cell-fit whitespace-nowrap text-center text-xs">
            {% if c.nb_gelees|default(0) > 0 %}
                <span class="inline-flex items-center rounded-full bg-navy/10 px-2 py-0.5 font-semibold text-navy" title="Factures hors relance client (relance site / en pause)">{{ c.nb_gelees }}</span>
            {% else %}
                <span class="text-ink/30">—</span>
            {% endif %}
        </td>
        <td class="fc-cell-fit text-center">
            <button type="button" data-action="curation#basculer" data-compte="{{ c.compte }}" data-ecarte="{{ c.ecarte ? '1' : '0' }}"
                    class="curation-statut inline-flex items-center justify-center rounded-md border p-1.5 transition {{ c.ecarte ? 'border-negative/40 text-negative hover:bg-negative/10' : 'border-positive/40 text-positive hover:bg-positive/10' }}"
                    title="{{ c.ecarte ? 'Écarté — cliquer pour réintégrer' : 'Relançable — cliquer pour écarter' }}">
                {% if c.ecarte %}
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                {% else %}
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                {% endif %}
            </button>
        </td>
        <td class="fc-cell-fit whitespace-nowrap text-center">
            <div class="inline-flex items-center gap-1.5">
                <div class="inline-flex items-center gap-1" title="Relancer ce client au niveau choisi">
                    <button type="button" data-action="relance-manuelle#relancerClient" data-compte="{{ c.compte }}" data-niveau="1"
                            class="rounded-md border border-navy/25 px-2 py-1 text-[0.7rem] font-semibold text-navy transition hover:bg-navy/5" title="Relance niveau 1">N1</button>
                    <button type="button" data-action="relance-manuelle#relancerClient" data-compte="{{ c.compte }}" data-niveau="2"
                            class="rounded-md border border-navy/25 px-2 py-1 text-[0.7rem] font-semibold text-navy transition hover:bg-navy/5" title="Relance niveau 2">N2</button>
                    <button type="button" data-action="relance-manuelle#relancerClient" data-compte="{{ c.compte }}" data-niveau="med"
                            class="rounded-md border border-negative/40 px-2 py-1 text-[0.7rem] font-semibold text-negative transition hover:bg-negative/10" title="Mise en demeure">MED</button>
                </div>
                <button type="button" data-action="apercu-drawer#ouvrir" data-compte="{{ c.compte }}"
                        class="inline-flex items-center justify-center rounded-md border border-hairline p-1.5 text-ink/60 transition hover:border-navy hover:text-navy" title="Aperçu rapide">
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
                <a href="{{ path('app_recouvrement_fiche_client', {compte: c.compte}) }}"
                   class="inline-flex items-center justify-center rounded-md border border-hairline p-1.5 text-ink/60 transition hover:border-navy hover:text-navy" title="Ouvrir la fiche client">
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20a6 6 0 0 0-12 0"/><circle cx="12" cy="10" r="4"/><circle cx="12" cy="12" r="10"/></svg>
                </a>
            </div>
        </td>
    </tr>
{% else %}
    <tr data-relance-manuelle-empty>
        <td colspan="7" class="px-4 py-10 text-center text-ink/60">{% if q is defined and q %}Aucun client pour cette recherche.{% else %}Aucun client.{% endif %}</td>
    </tr>
{% endfor %}
