{# Contenu du panneau de l'ampoule, charge en une fois au premier clic.
   Deux onglets : proposer, et le suivi de ses propres remontees — une boite a
   idees ou rien ne revient meurt en trois semaines. #}
<div class="flex items-center justify-between border-b border-hairline px-4 py-3">
    <p class="text-sm font-bold text-navy">Une idée pour Finance Créances ?</p>
    <button type="button" data-action="suggestion#fermer" class="rounded-lg p-1 text-ink/45 transition hover:bg-surface hover:text-navy" aria-label="Fermer">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
</div>

<div class="flex border-b border-hairline">
    <button type="button" data-action="suggestion#onglet" data-onglet="proposer" data-suggestion-target="ongletBouton"
            class="flex-1 border-b-2 border-navy px-3 py-2 text-xs font-semibold text-navy transition">Proposer</button>
    <button type="button" data-action="suggestion#onglet" data-onglet="mes" data-suggestion-target="ongletBouton"
            class="flex-1 border-b-2 border-transparent px-3 py-2 text-xs font-semibold text-ink/50 transition hover:text-navy">
        Mes remontées{% if mes_suggestions is not empty %} ({{ mes_suggestions|length }}){% endif %}
    </button>
</div>

{# ---- Onglet « Proposer » ---- #}
<div data-suggestion-target="onglet" data-onglet="proposer">
    <form method="post" action="{{ path('app_suggestions_envoyer') }}" data-action="suggestion#envoyer" class="p-4">
        <input type="hidden" name="_token" value="{{ csrf_token('suggestion') }}">
        <input type="hidden" name="route" value="{{ origine_route }}">
        <input type="hidden" name="url" value="{{ origine_url }}">

        <div class="flex gap-1.5">
            {% for type in types %}
                <label class="flex-1 cursor-pointer rounded-lg border border-hairline px-2 py-1.5 text-center text-xs font-medium text-ink/70 transition hover:border-navy/40 has-[:checked]:border-navy has-[:checked]:bg-navy has-[:checked]:text-white"
                       title="{{ type.aide }}">
                    <input type="radio" name="type" value="{{ type.value }}" class="sr-only"{% if loop.first %} checked{% endif %}>
                    {{ type.libelle }}
                </label>
            {% endfor %}
        </div>

        <textarea name="message" rows="4" maxlength="{{ longueur_max }}" required
                  data-suggestion-target="message"
                  data-action="input->suggestion#compter"
                  class="mt-3 w-full resize-none rounded-lg border border-hairline bg-white px-3 py-2 text-sm text-ink placeholder:text-ink/35 focus:border-navy/40 focus:outline-none focus:ring-1 focus:ring-navy/20"
                  placeholder="Ce qui vous ferait gagner du temps, ce qui manque, ce qui coince..."></textarea>

        <div class="mt-1 flex items-baseline justify-between text-[0.7rem] text-ink/45">
            <span>
                {% if origine_module %}Depuis {{ origine_module }}{% elseif origine_url %}Depuis {{ origine_url }}{% endif %}
            </span>
            <span data-suggestion-target="compteur">0 / {{ longueur_max }}</span>
        </div>

        <p data-suggestion-target="erreur" hidden class="mt-2 rounded-lg border border-negative/30 bg-negative/10 px-3 py-2 text-xs text-negative"></p>

        <button type="submit" data-suggestion-target="envoi"
                class="mt-3 w-full rounded-lg bg-navy px-4 py-2 text-sm font-semibold text-white transition hover:bg-navy-light disabled:opacity-50">
            Envoyer
        </button>
    </form>
</div>

{# ---- Onglet « Mes remontees » ---- #}
<div data-suggestion-target="onglet" data-onglet="mes" hidden>
    {% if mes_suggestions is empty %}
        <p class="px-4 py-8 text-center text-xs text-ink/50">Vous n'avez encore rien proposé.</p>
    {% else %}
        <ul class="max-h-72 divide-y divide-hairline overflow-y-auto">
            {% for s in mes_suggestions %}
                <li class="px-4 py-3">
                    <div class="flex items-start justify-between gap-2">
                        {# Troncature visuelle (line-clamp) : pas de dependance Twig String. #}
                        <p class="line-clamp-3 text-xs leading-snug text-ink">{{ s.message }}</p>
                        <span class="shrink-0 rounded-full border px-2 py-0.5 text-[0.65rem] font-semibold {{ s.statut.classesBadge }}">{{ s.statut.libelle }}</span>
                    </div>
                    <p class="mt-1 text-[0.65rem] text-ink/40">
                        {{ s.type.libelle }}{% if s.module %} · {{ s.module.libelle }}{% endif %} · {{ s.createdAt|date('d/m/Y') }}
                        {%- if s.estSurLeMur %} · {{ pluriel(s.nbVotes, 'soutien', 'soutiens') }}{% endif %}
                    </p>
                    {% if s.reponse %}
                        <p class="mt-1.5 rounded-lg bg-surface px-2.5 py-1.5 text-[0.7rem] leading-snug text-ink/75">
                            <span class="font-semibold text-navy">{{ s.traitePar }} :</span> {{ s.reponse }}
                        </p>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>

<div class="border-t border-hairline bg-surface px-4 py-2 text-center">
    <a href="{{ path('app_suggestions_index') }}" class="text-xs font-medium text-navy transition hover:text-gold-dark">Voir le mur des idées</a>
</div>
