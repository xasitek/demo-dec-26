{% extends 'layout.html.twig' %}

{% block title %}Mon site — dossiers bloqués{% endblock %}
{% block page_title %}Dossiers grands comptes{% endblock %}
{% block topbar_nav %}{% include 'grands_comptes/_nav.html.twig' with { active: 'mon_site' } %}{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-[1560px]">

  <section class="mb-4 rounded-xl border border-hairline bg-white p-4 shadow-sm">
    <div class="flex flex-wrap items-baseline gap-2">
      <h3 class="text-sm font-bold uppercase tracking-wide text-ink/70">
        Ce qui bloque sur mon site
      </h3>
      {% if perimetre %}
        <span class="rounded bg-navy/10 px-2 py-0.5 font-mono text-[11px] font-semibold text-navy">
          {{ etablissement ? etablissement.nom : perimetre }} · {{ perimetre }}
        </span>
      {% endif %}
      <span class="ml-auto text-[11px] text-ink/45">
        arrêté au {{ arrete|date('d/m/Y') }} · {{ ms|number_format(0, ',', ' ') }} ms
      </span>
    </div>
    <p class="mt-1.5 max-w-4xl text-[12.5px] leading-relaxed text-ink/70">
      Chaque ligne est un véhicule livré dont le loueur ne paiera pas tant qu'une pièce manque.
      La pièce est <b>nommée</b>, le montant bloqué est <b>chiffré</b>, et la personne qui doit
      agir est <b>désignée</b>. Vous ne voyez que votre établissement.
    </p>
    {% if perimetre_par_defaut %}
      <p class="mt-2 rounded-lg border border-warning/40 bg-warning/5 px-3 py-2 text-[11.5px] leading-relaxed text-ink/75">
        <b>Périmètre déduit.</b> Aucun rattachement d'établissement n'est déclaré pour ce compte :
        le périmètre a été résolu sur l'établissement portant le plus d'encours. Un périmètre déduit
        n'est pas un périmètre déclaré, et l'écran préfère le dire.
      </p>
    {% endif %}
    {% for message in app.flashes('fait') %}
      <p class="mt-2 rounded-lg border border-positive/40 bg-positive/5 px-3 py-2 text-[12.5px] font-semibold text-positive">{{ message }}</p>
    {% endfor %}
  </section>

  {% include 'grands_comptes/_files.html.twig' with { route: 'app_gc_mon_site' } %}

  {# ------------------------------------------- ce qui bloque, et depuis quand #}
  <div class="mb-4 grid gap-3 lg:grid-cols-2">
    <section class="rounded-xl border border-hairline bg-white p-4 shadow-sm">
      <h3 class="mb-1 text-sm font-bold uppercase tracking-wide text-ink/70">Quelle pièce bloque</h3>
      <p class="mb-2 text-[11.5px] leading-relaxed text-ink/60">
        Chaque ligne ouvre la file des dossiers concernés : le chiffre n'est pas une statistique,
        c'est une porte.
      </p>
      {% if pieces_manquantes is empty %}
        <p class="rounded-lg border border-hairline bg-surface px-3 py-4 text-center text-[12px] text-ink/50">
          Aucune pièce manquante sur votre site.
        </p>
      {% else %}
        <table class="fc-table-comptable w-full">
          <thead><tr><th>Pièce</th><th class="text-right">Dossiers</th>
            <th class="text-right">Montant bloqué</th><th class="text-right">Traiter</th></tr></thead>
          <tbody>
            {% for p in pieces_manquantes %}
              <tr>
                <td class="text-[12.5px]"><b class="font-mono text-[11px]">{{ p.type_piece }}</b>
                  <span class="ml-1">{{ p.libelle }}</span></td>
                <td class="text-right font-mono text-[12px] font-semibold">{{ p.n|number_format(0, ',', ' ') }}</td>
                <td class="text-right font-mono text-[12px] font-semibold text-warning">
                  {{ (p.montant / 1000)|number_format(0, ',', ' ') }} k€</td>
                <td class="text-right">
                  <a href="{{ path('app_gc_mon_site', {etat: 'a_completer'}) }}"
                     class="text-[11.5px] font-semibold text-navy hover:underline">La file →</a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </section>

    <section class="rounded-xl border border-hairline bg-white p-4 shadow-sm">
      <h3 class="mb-1 text-sm font-bold uppercase tracking-wide text-ink/70">Depuis combien de temps</h3>
      <p class="mb-2 text-[11.5px] leading-relaxed text-ink/60">
        Un dossier qui dort trois mois est un loueur qui n'a pas payé depuis trois mois.
      </p>
      {% if anciennete is empty %}
        <p class="rounded-lg border border-hairline bg-surface px-3 py-4 text-center text-[12px] text-ink/50">
          Rien de bloqué.
        </p>
      {% else %}
        <table class="fc-table-comptable w-full">
          <thead><tr><th>Ancienneté de la livraison</th><th class="text-right">Dossiers</th>
            <th class="text-right">Montant bloqué</th></tr></thead>
          <tbody>
            {% for a in anciennete %}
              <tr class="{{ a.rang >= 3 ? 'bg-negative/5' : '' }}">
                <td class="text-[12.5px]">{{ a.tranche }}</td>
                <td class="text-right font-mono text-[12px]">{{ a.n|number_format(0, ',', ' ') }}</td>
                <td class="text-right font-mono text-[12px] font-semibold">
                  {{ (a.montant / 1000)|number_format(0, ',', ' ') }} k€</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        <p class="mt-2 text-[11px] text-ink/45">
          La teinte n'est posée qu'au-delà de 90 jours : c'est la borne à partir de laquelle un
          dossier documentaire cesse d'être un retard et devient un litige.
        </p>
      {% endif %}
    </section>
  </div>

  {# ------------------------------------------------------------ la file #}
  <section class="rounded-xl border border-hairline bg-white p-4 shadow-sm">
    <div class="mb-2 flex flex-wrap items-baseline gap-2">
      <h3 class="text-sm font-bold uppercase tracking-wide text-ink/70">{{ etats[etat].libelle }}</h3>
      <span class="rounded-full bg-ink/10 px-2 py-0.5 text-xs font-semibold text-ink/60">
        {{ ((page - 1) * par_page + (lignes|length > 0 ? 1 : 0))|number_format(0, ',', ' ') }}
        à {{ ((page - 1) * par_page + lignes|length)|number_format(0, ',', ' ') }}
        sur {{ total|number_format(0, ',', ' ') }}
      </span>
      <span class="ml-auto text-[11px] text-ink/45">{{ etats[etat].quoi }}</span>
    </div>

    {% if lignes is empty %}
      <p class="rounded-lg border border-hairline bg-surface px-3 py-6 text-center text-[12.5px] text-ink/50">
        Rien dans cette file sur votre site.
      </p>
    {% else %}
      <div class="overflow-x-auto">
        <table class="fc-table-comptable w-full">
          <thead><tr>
            <th>Dossier</th><th>Véhicule</th><th>Loueur</th>
            <th class="text-right">Montant bloqué</th><th>Il manque</th>
            <th>Responsable</th><th class="text-right">Ancienneté</th>
            <th>Créance liée</th><th>Prochaine action</th><th class="text-right"></th>
          </tr></thead>
          <tbody>
            {% for l in lignes %}
              <tr class="{{ l.age > 90 ? 'bg-negative/5' : (l.manquantes > 0 ? 'bg-warning/5' : '') }}">
                <td class="font-mono text-[11.5px] font-semibold">{{ l.id }}</td>
                <td class="text-[12px]"><b>{{ l.immatriculation }}</b>
                  <span class="ml-1 text-[11px] text-ink/50">{{ l.modele }}</span>
                  {% if l.energie in ['electrique', 'hybride'] %}
                    <span class="ml-1 rounded bg-positive/10 px-1 text-[10px] font-semibold text-positive">{{ l.energie }}</span>
                  {% endif %}
                </td>
                <td class="text-[12px]">{{ l.loueur_nom }}
                  <span class="ml-1 text-[10.5px] text-ink/45">{{ l.delai_paiement }} j</span></td>
                <td class="text-right font-mono text-[12px] font-semibold">{{ l.montant_facture|number_format(2, ',', ' ') }} €</td>
                <td class="text-[11.5px] font-semibold {{ l.pieces_manquantes ? 'text-warning' : 'text-ink/40' }}">
                  {{ l.pieces_manquantes ?: '—' }}</td>
                <td class="font-mono text-[11px] text-ink/55">{{ l.secretaire_id }}</td>
                <td class="text-right font-mono text-[12px] {{ l.age > 90 ? 'font-semibold text-negative' : 'text-ink/60' }}">
                  {{ l.age }} j</td>
                <td class="text-[11px]">
                  {% if l.creance_liee %}
                    <a href="{{ path('app_gc_pont') }}" class="font-mono font-semibold text-navy hover:underline">
                      {{ l.creance_liee }}</a>
                  {% else %}
                    <span class="text-ink/30">—</span>
                  {% endif %}
                </td>
                <td class="text-[11px] leading-snug text-ink/65">{{ etats[l.etat].quoi }}</td>
                <td class="text-right">
                  <div class="flex flex-wrap items-center justify-end gap-1">
                    <a href="{{ path('app_gc_controle_dossier', {id: l.id}) }}"
                       class="whitespace-nowrap rounded-md border border-hairline px-2 py-1 text-[11px]
                              font-semibold text-navy hover:bg-navy/5">Voir les pièces</a>
                    <details class="relative">
                      <summary class="cursor-pointer whitespace-nowrap rounded-md border border-navy/40
                                      px-2 py-1 text-[11px] font-semibold text-navy hover:bg-navy/5">
                        Demander</summary>
                      <form method="post" action="{{ path('app_gc_demander', {id: l.id}) }}"
                            class="absolute right-0 z-20 mt-1 w-72 rounded-xl border border-hairline
                                   bg-white p-2 text-left shadow-lg">
                        <input type="hidden" name="etat" value="{{ etat }}">
                        <textarea name="commentaire" rows="3" maxlength="360"
                                  placeholder="Ce que le site doit faire, en une phrase…"
                                  class="w-full rounded-lg border border-hairline px-2 py-1.5 text-[12px]"></textarea>
                        <button type="submit"
                                class="mt-1 w-full rounded-lg bg-navy px-2 py-1.5 text-[11.5px] font-semibold
                                       text-white hover:bg-navy-deep">
                          Demander à la secrétaire de compléter</button>
                      </form>
                    </details>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if pages > 1 %}
        <div class="mt-3 flex flex-wrap items-center gap-2">
          {% if page > 1 %}
            <a href="{{ path('app_gc_mon_site', {etat: etat, page: page - 1}) }}"
               class="rounded-lg border border-hairline px-3 py-1.5 text-[12px] font-semibold text-navy hover:bg-navy/5">
              ← Page précédente</a>
          {% endif %}
          <span class="text-[12px] font-semibold text-ink/60">page {{ page }} sur {{ pages }}</span>
          {% if page < pages %}
            <a href="{{ path('app_gc_mon_site', {etat: etat, page: page + 1}) }}"
               class="rounded-lg border border-hairline px-3 py-1.5 text-[12px] font-semibold text-navy hover:bg-navy/5">
              Page suivante →</a>
          {% endif %}
        </div>
      {% endif %}
      <p class="mt-2 text-[11px] leading-relaxed text-ink/45">
        Une demande adressée au site est <b>datée et signée</b>, et figure dans l'historique du
        dossier. Vous ne voyez et vous ne relancez que votre établissement : le périmètre filtre
        dans les requêtes, pas à l'affichage.
      </p>
    {% endif %}
  </section>

</div>
{% endblock %}
