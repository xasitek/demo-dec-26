{% extends 'layout.html.twig' %}

{% block title %}Mes dossiers de livraison{% endblock %}
{% block page_title %}Dossiers grands comptes{% endblock %}
{% block topbar_nav %}{% include 'grands_comptes/_nav.html.twig' with { active: 'secretaire' } %}{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-[1500px]">

  <section class="mb-4 rounded-xl border border-hairline bg-white p-4 shadow-sm">
    <div class="flex flex-wrap items-baseline gap-2">
      <h3 class="text-sm font-bold uppercase tracking-wide text-ink/70">Mes dossiers de livraison</h3>
      <span class="ml-auto text-[11px] text-ink/45">
        arrêté au {{ arrete|date('d/m/Y') }} · {{ ms|number_format(0, ',', ' ') }} ms
      </span>
    </div>
    <p class="mt-1.5 max-w-4xl text-[12.5px] leading-relaxed text-ink/70">
      Un véhicule livré sans dossier complet ne se paie pas : le loueur attend ses pièces, et la
      créance reste ouverte sans que personne ne sache pourquoi. <b>Chaque loueur exige des pièces
      différentes</b> — c'est sa grille qui commande, et l'écran ne réclame jamais une pièce que
      votre payeur ne demande pas.
    </p>

    <form method="get" class="mt-3 flex flex-wrap items-center gap-2">
      <input type="hidden" name="etat" value="{{ etat }}">
      <div class="relative min-w-[20rem] flex-1">
        <input type="search" name="q" value="{{ q }}" autocomplete="off"
               placeholder="Immatriculation, VIN, dossier, facture, loueur, établissement…"
               class="w-full rounded-xl border border-hairline bg-white px-3 py-2.5 pl-9 text-[13px] shadow-sm
                      focus:border-navy focus:outline-none">
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink/35">⌕</span>
      </div>
      <button type="submit" class="rounded-xl bg-navy px-4 py-2.5 text-[13px] font-semibold text-white hover:bg-navy-deep">
        Rechercher</button>
      {% if q %}
        <a href="{{ path('app_gc_secretaire', {etat: etat}) }}"
           class="text-[12px] font-semibold text-navy hover:underline">Effacer</a>
      {% endif %}
    </form>

    {% for message in app.flashes('fait') %}
      <p class="mt-2 rounded-lg border border-positive/40 bg-positive/5 px-3 py-2 text-[12.5px] font-semibold text-positive">{{ message }}</p>
    {% endfor %}
    {% for message in app.flashes('erreur') %}
      <p class="mt-2 rounded-lg border border-negative/40 bg-negative/5 px-3 py-2 text-[12.5px] font-semibold text-negative">{{ message }}</p>
    {% endfor %}
  </section>

  {% include 'grands_comptes/_files.html.twig' with { route: 'app_gc_secretaire' } %}

  <section class="rounded-xl border border-hairline bg-white p-4 shadow-sm">
    <div class="mb-2 flex flex-wrap items-baseline gap-2">
      <h3 class="text-sm font-bold uppercase tracking-wide text-ink/70">{{ etats[etat].libelle }}</h3>
      <span class="rounded-full bg-ink/10 px-2 py-0.5 text-xs font-semibold text-ink/60">
        {{ ((page - 1) * par_page + (lignes|length > 0 ? 1 : 0))|number_format(0, ',', ' ') }}
        à {{ ((page - 1) * par_page + lignes|length)|number_format(0, ',', ' ') }}
        sur {{ total|number_format(0, ',', ' ') }}
      </span>
    </div>
    <p class="mb-3 text-[12.5px] leading-relaxed text-ink/75">{{ etats[etat].quoi }}</p>

    {% if lignes is empty %}
      <p class="rounded-lg border border-hairline bg-surface px-3 py-6 text-center text-[12.5px] text-ink/50">
        Rien dans cette file.
      </p>
    {% else %}
      <div class="overflow-x-auto">
        <table class="fc-table-comptable w-full">
          <thead><tr>
            <th>Dossier</th><th>Véhicule</th><th>Loueur</th><th>Site</th>
            <th class="text-right">Montant</th><th>Livré le</th>
            <th class="text-center">Pièces</th><th>Il manque</th><th class="text-right">Action</th>
          </tr></thead>
          <tbody>
            {% for l in lignes %}
              <tr class="{{ l.manquantes > 0 ? 'bg-warning/5' : '' }}">
                <td class="font-mono text-[11.5px] font-semibold">{{ l.id }}</td>
                <td class="text-[12px]">
                  <b>{{ l.immatriculation }}</b>
                  <span class="ml-1 text-[11px] text-ink/50">{{ l.modele }}</span>
                  {% if l.energie in ['electrique', 'hybride'] %}
                    <span class="ml-1 rounded bg-positive/10 px-1 text-[10px] font-semibold text-positive">
                      {{ l.energie }}</span>
                  {% endif %}
                </td>
                <td class="text-[12px]">{{ l.loueur_nom }}
                  <span class="ml-1 text-[10.5px] text-ink/45">{{ l.delai_paiement }} j</span>
                  {% if l.premier_reglement %}
                    <span class="ml-1 rounded bg-gold/15 px-1 text-[10px] font-semibold text-gold">1er règlement</span>
                  {% endif %}
                </td>
                <td class="text-[11.5px] text-ink/60">{{ l.etablissement_nom ?: l.etablissement_id }}</td>
                <td class="text-right font-mono text-[12px] font-semibold">{{ l.montant_facture|number_format(2, ',', ' ') }} €</td>
                <td class="text-[11.5px] text-ink/60">{{ l.date_livraison|date('d/m/Y') }}</td>
                <td class="text-center font-mono text-[12px]">
                  <b class="{{ l.presentes < l.attendues ? 'text-warning' : 'text-positive' }}">{{ l.presentes }}</b>
                  <span class="text-ink/35">/{{ l.attendues }}</span>
                </td>
                <td class="text-[11.5px] font-semibold {{ l.manquantes > 0 ? 'text-warning' : 'text-ink/40' }}">
                  {{ l.manquantes > 0 ? l.manquantes ~ ' pièce' ~ (l.manquantes > 1 ? 's' : '') : '—' }}
                </td>
                <td class="text-right">
                  <a href="{{ path('app_gc_deposer', {id: l.id}) }}"
                     class="whitespace-nowrap rounded-md border border-navy/40 px-2.5 py-1 text-[11.5px]
                            font-semibold text-navy transition hover:bg-navy/5">
                    {{ l.manquantes > 0 ? 'Compléter →' : 'Ouvrir →' }}
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if pages > 1 %}
        <div class="mt-3 flex flex-wrap items-center gap-2">
          {% if page > 1 %}
            <a href="{{ path('app_gc_secretaire', {etat: etat, q: q, page: page - 1}) }}"
               class="rounded-lg border border-hairline px-3 py-1.5 text-[12px] font-semibold text-navy hover:bg-navy/5">
              ← Page précédente</a>
          {% endif %}
          <span class="text-[12px] font-semibold text-ink/60">page {{ page }} sur {{ pages|number_format(0, ',', ' ') }}</span>
          {% if page < pages %}
            <a href="{{ path('app_gc_secretaire', {etat: etat, q: q, page: page + 1}) }}"
               class="rounded-lg border border-hairline px-3 py-1.5 text-[12px] font-semibold text-navy hover:bg-navy/5">
              Page suivante →</a>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}
  </section>

</div>
{% endblock %}
