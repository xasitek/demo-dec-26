{% extends 'layout.html.twig' %}

{% block title %}Lettrage des écritures{% endblock %}
{% block page_title %}Lettrage des écritures{% endblock %}
{% block topbar_nav %}{% include 'lettrage/_nav.html.twig' with { active: 'file' } %}{% endblock %}

{% set champ = 'w-full rounded-lg border border-hairline bg-white px-3 py-2 text-sm text-ink transition focus:border-navy focus:outline-none focus:ring-4 focus:ring-navy/10' %}

{% block content %}
<div class="mx-auto w-full max-w-[1500px]">

  {# --------------------------------------------------- la question de l'outil #}
  <section class="mb-4 rounded-xl border border-hairline bg-white p-4 shadow-sm">
    <p class="text-[13.5px] leading-relaxed text-ink/80">
      L'outil précédent répond à <b>« à qui appartient cet argent »</b>. Celui-ci répond à la
      question suivante, la seule qui produise une écriture :
      <b class="text-navy">« quelles créances ce règlement solde-t-il exactement »</b>.
    </p>
  </section>

  {# --------------------------------------------------- le chiffré, tout calculé #}
  <div class="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-5">
    <div class="rounded-xl border border-hairline bg-white px-4 py-3 shadow-sm">
      <div class="text-[10px] font-semibold uppercase tracking-wider text-ink/40">Écritures au journal</div>
      <div class="text-lg font-bold text-navy">{{ recap.stock|default(0)|number_format(0, ',', ' ') }}</div>
      <div class="text-[11px] text-ink/45">{{ recap.non_lettrees|default(0)|number_format(0, ',', ' ') }} non lettrées</div>
    </div>
    <div class="rounded-xl border border-hairline bg-white px-4 py-3 shadow-sm">
      <div class="text-[10px] font-semibold uppercase tracking-wider text-ink/40">Lettrage automatique</div>
      <div class="text-lg font-bold text-positive">{{ recap.lots > 0 ? (recap.auto / recap.lots * 100)|number_format(1, ',', ' ') : '0,0' }} <span class="text-xs text-gold">%</span></div>
      <div class="text-[11px] text-ink/45">{{ recap.ecritures_auto|default(0)|number_format(0, ',', ' ') }} écritures</div>
    </div>
    <div class="rounded-xl border border-hairline bg-white px-4 py-3 shadow-sm">
      <div class="text-[10px] font-semibold uppercase tracking-wider text-ink/40">Montant lettré</div>
      <div class="text-lg font-bold text-navy">{{ (recap.montant_auto|default(0) / 1000000)|number_format(1, ',', ' ') }} <span class="text-xs text-gold">M€</span></div>
      <div class="text-[11px] text-ink/45">sans intervention</div>
    </div>
    <div class="rounded-xl border border-hairline bg-white px-4 py-3 shadow-sm">
      <div class="text-[10px] font-semibold uppercase tracking-wider text-ink/40">Laissé au comptable</div>
      <div class="text-lg font-bold text-warning">{{ (recap.montant_humain|default(0) / 1000000)|number_format(1, ',', ' ') }} <span class="text-xs text-gold">M€</span></div>
      <div class="text-[11px] text-ink/45">{{ (recap.humain|default(0) + recap.refus|default(0))|number_format(0, ',', ' ') }} lots</div>
    </div>
    <div class="rounded-xl border border-hairline bg-white px-4 py-3 shadow-sm">
      <div class="text-[10px] font-semibold uppercase tracking-wider text-ink/40">Lettrages à revoir</div>
      <div class="text-lg font-bold text-negative">{{ recap.a_revoir|default(0)|number_format(0, ',', ' ') }}</div>
      <div class="text-[11px] text-ink/45">déjà posés, contestés</div>
    </div>
  </div>

  {# --------------------------------------------------- les cas à découvrir #}
  <div class="mb-4 grid gap-3 lg:grid-cols-3">
    {% if vedettes.convergence %}
      <a href="{{ path('app_lettrage_lot', {id: vedettes.convergence.lot_id}) }}"
         class="group rounded-xl border-2 border-navy/30 bg-navy/5 p-4 shadow-sm transition hover:border-navy">
        <div class="mb-1 flex items-center gap-2">
          <span class="rounded bg-navy/10 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-navy">Cas A</span>
          <span class="font-mono text-[11px] text-ink/45">{{ vedettes.convergence.lot_id }}</span>
        </div>
        <div class="text-[13.5px] font-semibold text-ink">Aucune preuve suffisante isolément</div>
        <p class="mt-1 text-[12px] leading-relaxed text-ink/60">
          Montant non identique, aucune référence de pièce.
          <b>{{ vedettes.convergence.nb_indices }} indices convergent</b> et emportent la conviction.
          <span class="font-semibold text-navy group-hover:underline">Ouvrir →</span>
        </p>
      </a>
    {% endif %}
    {% if vedettes.contradiction %}
      <a href="{{ path('app_lettrage_lot', {id: vedettes.contradiction.lot_id}) }}"
         class="group rounded-xl border-2 border-warning/50 bg-warning/5 p-4 shadow-sm transition hover:border-warning">
        <div class="mb-1 flex items-center gap-2">
          <span class="rounded bg-warning/20 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-warning">Cas B</span>
          <span class="font-mono text-[11px] text-ink/45">{{ vedettes.contradiction.lot_id }}</span>
        </div>
        <div class="text-[13.5px] font-semibold text-ink">Même montant, numéro de série contradictoire</div>
        <p class="mt-1 text-[12px] leading-relaxed text-ink/60">
          Un algorithme naïf les rapprocherait. Une clé sectorielle forte s'y oppose :
          <b>lettrage refusé</b>.
          <span class="font-semibold text-navy group-hover:underline">Ouvrir →</span>
        </p>
      </a>
    {% endif %}
    {% if vedettes.sousensemble %}
      <a href="{{ path('app_lettrage_lot', {id: vedettes.sousensemble.lot_id}) }}"
         class="group rounded-xl border border-hairline bg-white p-4 shadow-sm transition hover:border-navy">
        <div class="mb-1 flex items-center gap-2">
          <span class="rounded bg-ink/10 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-ink/60">Cas C</span>
          <span class="font-mono text-[11px] text-ink/45">{{ vedettes.sousensemble.lot_id }}</span>
        </div>
        <div class="text-[13.5px] font-semibold text-ink">Un règlement, plusieurs écritures</div>
        <p class="mt-1 text-[12px] leading-relaxed text-ink/60">
          {{ vedettes.sousensemble.nb_ecritures }} écritures composent
          {{ vedettes.sousensemble.montant|number_format(2, ',', ' ') }} €. La combinaison est
          réellement cherchée, et le compte des nœuds explorés est affiché.
          <span class="font-semibold text-navy group-hover:underline">Ouvrir →</span>
        </p>
      </a>
    {% endif %}
  </div>

  {# --------------------------------------------------- les deux tolérances #}
  {% if vedettes.jeune and vedettes.ancien %}
    <section class="mb-4 rounded-xl border border-hairline bg-white p-4 shadow-sm">
      <h3 class="mb-2 text-sm font-bold uppercase tracking-wide text-ink/70">
        Le même écart de 12 €, deux décisions
      </h3>
      <p class="mb-3 text-[12.5px] leading-relaxed text-ink/70">
        Douze euros sur une créance de vingt jours sont une erreur qu'il faut comprendre : un
        escompte non prévu, un frais bancaire, une saisie fausse. Les mêmes douze euros sur une
        créance de quatorze mois sont un résidu qu'il coûterait plus cher d'instruire que
        d'apurer. Le moteur ne décide donc pas la même chose.
      </p>
      <div class="grid gap-3 sm:grid-cols-2">
        <a href="{{ path('app_lettrage_lot', {id: vedettes.jeune.lot_id}) }}"
           class="group rounded-lg border border-warning/40 bg-warning/5 px-3 py-2 transition hover:border-warning">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-warning">Créance récente</div>
          <div class="text-[13px] font-semibold text-ink">{{ vedettes.jeune.montant|number_format(2, ',', ' ') }} €
            — {% include 'lettrage/_badge.html.twig' with { verdict: vedettes.jeune.verdict } %}</div>
          <div class="mt-0.5 text-[11.5px] text-ink/55">Tolérance 5 € : l'écart ne passe pas.
            <span class="font-semibold text-navy group-hover:underline">Pourquoi ? →</span></div>
        </a>
        <a href="{{ path('app_lettrage_lot', {id: vedettes.ancien.lot_id}) }}"
           class="group rounded-lg border border-positive/40 bg-positive/5 px-3 py-2 transition hover:border-positive">
          <div class="text-[11px] font-semibold uppercase tracking-wider text-positive">Créance ancienne</div>
          <div class="text-[13px] font-semibold text-ink">{{ vedettes.ancien.montant|number_format(2, ',', ' ') }} €
            — {% include 'lettrage/_badge.html.twig' with { verdict: vedettes.ancien.verdict, methode: vedettes.ancien.methode } %}</div>
          <div class="mt-0.5 text-[11.5px] text-ink/55">Tolérance 100 € : l'écart est apuré.
            <span class="font-semibold text-navy group-hover:underline">Pourquoi ? →</span></div>
        </a>
      </div>
    </section>
  {% endif %}

  {% if vedettes.solde or vedettes.ambigu %}
    <div class="mb-4 grid gap-3 sm:grid-cols-2">
      {% if vedettes.solde %}
        <a href="{{ path('app_lettrage_lot', {id: vedettes.solde.lot_id}) }}"
           class="group rounded-xl border-2 border-negative/40 bg-negative/5 p-4 shadow-sm transition hover:border-negative">
          <div class="mb-1 text-[10px] font-bold uppercase tracking-wider text-negative">Garde-fou de solde</div>
          <div class="text-[13.5px] font-semibold text-ink">Toutes les clés concordent, et c'est refusé</div>
          <p class="mt-1 text-[12px] leading-relaxed text-ink/60">
            Le groupe laisserait un solde résiduel. <b>Aucun code de lettrage n'est posé parce
            qu'une ressemblance est forte.</b>
            <span class="font-semibold text-navy group-hover:underline">Ouvrir →</span>
          </p>
        </a>
      {% endif %}
      {% if vedettes.ambigu %}
        <a href="{{ path('app_lettrage_lot', {id: vedettes.ambigu.lot_id}) }}"
           class="group rounded-xl border-2 border-warning/40 bg-warning/5 p-4 shadow-sm transition hover:border-warning">
          <div class="mb-1 text-[10px] font-bold uppercase tracking-wider text-warning">Deux réponses possibles</div>
          <div class="text-[13.5px] font-semibold text-ink">Deux jeux d'écritures équilibrent le même total</div>
          <p class="mt-1 text-[12px] leading-relaxed text-ink/60">
            Le compte serait juste au total et <b>faux ligne à ligne</b>. Le choix des créances
            revient au comptable.
            <span class="font-semibold text-navy group-hover:underline">Ouvrir →</span>
          </p>
        </a>
      {% endif %}
    </div>
  {% endif %}

  {# --------------------------------------------------- filtres et file #}
  <div class="mb-2 flex items-center gap-2">
    <h2 class="text-sm font-bold uppercase tracking-wide text-ink/70">Propositions de lettrage</h2>
    <span class="rounded-full bg-ink/10 px-2 py-0.5 text-xs font-semibold text-ink/60">{{ lignes|length }}</span>
    <span class="ml-auto text-[11px] text-ink/40">
      durée moyenne d'analyse {{ recap.duree ?? '—' }} ms, mesurée sur cette machine
    </span>
  </div>

  <form method="get" class="mb-3 grid gap-2 sm:grid-cols-3">
    <input type="search" name="q" value="{{ q }}" placeholder="Lot, compte client, nom" class="{{ champ }}">
    <select name="verdict" class="{{ champ }}" onchange="this.form.submit()">
      <option value="">Tous les verdicts</option>
      {% for v in verdicts %}
        <option value="{{ v }}" {{ verdict == v ? 'selected' }}>
          {{ {'automatique': 'Lettrage automatique', 'proposition': 'Proposition',
              'humain': 'Intervention humaine', 'refus': 'Lettrage refusé'}[v] }}
        </option>
      {% endfor %}
    </select>
    <button type="submit" class="rounded-lg bg-navy px-4 py-2 text-sm font-semibold text-white transition hover:bg-navy-deep">
      Rechercher
    </button>
  </form>

  <section class="rounded-xl border border-hairline bg-white p-4 shadow-sm">
    <table class="fc-table-comptable w-full">
      <thead><tr>
        <th>Lot</th><th>Compte client</th><th class="text-right">Montant</th>
        <th class="text-right">Écritures</th><th>Méthode</th><th>Verdict</th>
        <th class="text-right">Solde</th><th></th>
      </tr></thead>
      <tbody>
        {% for l in lignes %}
          <tr>
            <td class="font-mono text-[12px]">{{ l.lot_id }}</td>
            <td class="text-[12px]">{{ l.client_nom ?: l.client_id }}</td>
            <td class="text-right font-mono text-[12px] font-semibold">{{ l.montant|number_format(2, ',', ' ') }} €</td>
            <td class="text-right font-mono text-[12px]">{{ l.lignes_lot }}</td>
            <td class="font-mono text-[11.5px] text-ink/60">{{ l.methode ?: '—' }}</td>
            <td>{% include 'lettrage/_badge.html.twig' with { verdict: l.verdict } %}</td>
            <td class="text-right font-mono text-[12px] {{ l.solde|abs > 0.01 ? 'text-warning' : 'text-ink/35' }}">
              {{ l.solde|number_format(2, ',', ' ') }} €</td>
            <td class="text-right"><a href="{{ path('app_lettrage_lot', {id: l.lot_id}) }}"
                class="text-[12px] font-semibold text-navy hover:underline">Ouvrir →</a></td>
          </tr>
        {% else %}
          <tr><td colspan="8" class="py-8 text-center text-[12px] text-ink/40">
            Aucune proposition. Lancez <span class="font-mono">app:lettrage:cascade</span>.
          </td></tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

</div>
{% endblock %}
