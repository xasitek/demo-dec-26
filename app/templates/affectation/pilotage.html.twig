{% extends 'layout.html.twig' %}

{% block title %}Pilotage de l'affectation{% endblock %}
{% block page_title %}Affectation des règlements{% endblock %}
{% block topbar_nav %}{% include 'affectation/_nav.html.twig' with { active: 'pilotage' } %}{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-[1500px]">

  <div class="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="rounded-xl border border-hairline bg-white px-4 py-3 shadow-sm">
      <div class="text-[10px] font-semibold uppercase tracking-wider text-ink/40">Taux d'identification</div>
      <div class="text-lg font-bold text-navy">{{ recap.n > 0 ? (recap.identifies / recap.n * 100)|number_format(1, ',', ' ') : '0,0' }} <span class="text-xs text-gold">%</span></div>
      <div class="text-[11px] text-ink/45">{{ recap.identifies|number_format(0, ',', ' ') }} payeurs retrouvés</div>
    </div>
    <div class="rounded-xl border border-hairline bg-white px-4 py-3 shadow-sm">
      <div class="text-[10px] font-semibold uppercase tracking-wider text-ink/40">Sans intervention</div>
      <div class="text-lg font-bold text-positive">{{ recap.n > 0 ? (recap.auto / recap.n * 100)|number_format(1, ',', ' ') : '0,0' }} <span class="text-xs text-gold">%</span></div>
      <div class="text-[11px] text-ink/45">{{ recap.montant_auto|number_format(0, ',', ' ') }} € affectés</div>
    </div>
    <div class="rounded-xl border border-hairline bg-white px-4 py-3 shadow-sm">
      <div class="text-[10px] font-semibold uppercase tracking-wider text-ink/40">Exceptions assumées</div>
      <div class="text-lg font-bold text-warning">{{ recap.n > 0 ? ((recap.exception + recap.refus) / recap.n * 100)|number_format(1, ',', ' ') : '0,0' }} <span class="text-xs text-gold">%</span></div>
      <div class="text-[11px] text-ink/45">{{ recap.montant_humain|number_format(0, ',', ' ') }} € à instruire</div>
    </div>
    <div class="rounded-xl border border-hairline bg-white px-4 py-3 shadow-sm">
      <div class="text-[10px] font-semibold uppercase tracking-wider text-ink/40">Durée moyenne d'analyse</div>
      <div class="text-lg font-bold text-navy">{{ recap.duree_moyenne ?? '—' }} <span class="text-xs text-gold">ms</span></div>
      <div class="text-[11px] text-ink/45">mesurée, jamais annoncée</div>
    </div>
  </div>

  <div class="grid gap-3 lg:grid-cols-2">

    <section class="rounded-xl border border-hairline bg-white p-4 shadow-sm">
      <h3 class="mb-3 text-sm font-bold uppercase tracking-wide text-ink/70">Par population</h3>
      <table class="fc-table-comptable w-full">
        <thead><tr><th>Population</th><th class="text-right">Virements</th><th class="text-right">Automatique</th>
          <th class="text-right">À valider</th><th class="text-right">Humain</th><th class="text-right">Durée</th></tr></thead>
        <tbody>
          {% for c in parCohorte %}
            <tr>
              <td class="font-mono text-[12px]">{{ c.cohorte }}</td>
              <td class="text-right font-mono text-[12px]">{{ c.n|number_format(0, ',', ' ') }}</td>
              <td class="text-right font-mono text-[12px] font-semibold text-positive">{{ c.n > 0 ? (c.auto / c.n * 100)|number_format(1, ',', ' ') : '0,0' }} %</td>
              <td class="text-right font-mono text-[12px]">{{ c.validation }}</td>
              <td class="text-right font-mono text-[12px] text-warning">{{ c.humain }}</td>
              <td class="text-right font-mono text-[11px] text-ink/50">{{ c.duree }} ms</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>

    <section class="rounded-xl border border-hairline bg-white p-4 shadow-sm">
      <h3 class="mb-3 text-sm font-bold uppercase tracking-wide text-ink/70">Sociétés qui demandent le plus d'intervention</h3>
      <table class="fc-table-comptable w-full">
        <thead><tr><th>Société</th><th class="text-right">Virements</th><th class="text-right">Automatique</th>
          <th class="text-right">Humain</th><th class="text-right">Montant</th></tr></thead>
        <tbody>
          {% for s in parSociete %}
            <tr>
              <td class="font-mono text-[12px]">{{ s.societe }}</td>
              <td class="text-right font-mono text-[12px]">{{ s.n }}</td>
              <td class="text-right font-mono text-[12px] text-positive">{{ s.auto }}</td>
              <td class="text-right font-mono text-[12px] font-semibold {{ s.humain > 0 ? 'text-warning' : 'text-ink/35' }}">{{ s.humain }}</td>
              <td class="text-right font-mono text-[12px]">{{ s.montant|number_format(0, ',', ' ') }} €</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <p class="mt-2 text-[11px] text-ink/45">
        C'est la lecture managériale : le taux d'intervention n'est pas réparti au hasard.
      </p>
    </section>
  </div>

  <section class="mt-3 rounded-xl border border-hairline bg-white p-4 shadow-sm">
    <div class="mb-3 flex items-baseline gap-2">
      <h3 class="text-sm font-bold uppercase tracking-wide text-ink/70">Les plus gros montants qui attendent une décision</h3>
      <span class="rounded-full bg-ink/10 px-2 py-0.5 text-xs font-semibold text-ink/60">{{ aTraiter|length }}</span>
      <span class="ml-auto text-[11px] text-ink/40">descente du pilotage jusqu'au virement, en un clic</span>
    </div>
    <table class="fc-table-comptable w-full">
      <thead><tr><th>Virement</th><th class="text-right">Montant</th><th>Libellé reçu</th>
        <th>Payeur proposé</th><th>Décision</th><th></th></tr></thead>
      <tbody>
        {% for l in aTraiter %}
          <tr>
            <td class="font-mono text-[12px]">{{ l.id }}</td>
            <td class="text-right font-mono text-[12px] font-semibold">{{ l.montant|number_format(2, ',', ' ') }} €</td>
            <td class="font-mono text-[11px] text-ink/55">{{ l.libelle }}</td>
            <td class="text-[12px]">{{ l.client_nom ?: '—' }}</td>
            <td>{% include 'affectation/_badge.html.twig' with { decision: l.decision, score: l.score } %}</td>
            <td class="text-right"><a href="{{ path('app_affectation_virement', {id: l.id}) }}"
                class="text-[12px] font-semibold text-navy hover:underline">Ouvrir →</a></td>
          </tr>
        {% else %}
          <tr><td colspan="6" class="py-8 text-center text-[12px] text-ink/40">Aucun virement en attente de décision.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </section>

</div>
{% endblock %}
