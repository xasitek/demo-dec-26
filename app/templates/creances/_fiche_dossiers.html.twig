{# Onglet "Dossiers" : litiges + echeanciers + contentieux du tiers. #}

<div class="pt-5">

    {# Formulaire de creation #}
    <form method="post"
          action="{{ path('app_creances_dossier_creer', { code: compte_code }) }}"
          class="mb-5 border-l-2 border-navy/15 pl-4">
        <input type="hidden" name="_token" value="{{ csrf_token('creances_dossier_creer_' ~ compte_code) }}">
        <p class="mb-3 text-[0.65rem] font-medium uppercase tracking-[0.12em] text-navy">Ouvrir un nouveau dossier</p>
        <div class="grid grid-cols-1 gap-2 md:grid-cols-3">
            <div>
                <label class="block text-[0.7rem] font-medium text-ink/65">Type</label>
                <select name="type" required class="w-full rounded-md border border-hairline px-2 py-1.5 text-sm focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/30">
                    <option value="litige">Litige</option>
                    <option value="echeancier">Echeancier de paiement</option>
                    <option value="contentieux">Contentieux</option>
                </select>
            </div>
            <div>
                <label class="block text-[0.7rem] font-medium text-ink/65">Date de debut</label>
                <input type="date" name="date_debut" value="{{ "now"|date('Y-m-d') }}" required
                       class="w-full rounded-md border border-hairline px-2 py-1.5 text-sm focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/30">
            </div>
            <div>
                <label class="block text-[0.7rem] font-medium text-ink/65">Date cible (optionnel)</label>
                <input type="date" name="date_resolution_cible"
                       class="w-full rounded-md border border-hairline px-2 py-1.5 text-sm focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/30">
            </div>
            <div class="md:col-span-3">
                <label class="block text-[0.7rem] font-medium text-ink/65">Libelle / motif</label>
                <input type="text" name="libelle" required maxlength="255" placeholder="Ex: Contestation sur facture frais de remise en etat"
                       class="w-full rounded-md border border-hairline px-2 py-1.5 text-sm focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/30">
            </div>
            <div class="md:col-span-3">
                <label class="block text-[0.7rem] font-medium text-ink/65">Description (optionnel)</label>
                <textarea name="description" rows="2" maxlength="2000"
                          class="w-full rounded-md border border-hairline px-2 py-1.5 text-sm focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/30"></textarea>
            </div>
        </div>
        <div class="mt-2 flex justify-end">
            <button type="submit" class="inline-flex items-center gap-1.5 rounded-md border border-navy bg-navy px-3 py-1.5 text-sm font-medium text-white transition hover:bg-navy-light">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                Ouvrir le dossier
            </button>
        </div>
    </form>

    {% if dossiers is empty %}
        <p class="text-sm text-ink/45">Aucun dossier metier (litige, echeancier ou contentieux) pour ce tiers.</p>
    {% else %}

        {% set type_libelle = {
            'echeancier': 'Echeancier',
            'litige': 'Litige',
            'contentieux': 'Contentieux'
        } %}
        {% set type_couleur = {
            'echeancier': 'bg-sky-50 text-sky-700 ring-sky-200',
            'litige': 'bg-amber-50 text-amber-700 ring-amber-200',
            'contentieux': 'bg-rose-50 text-rose-700 ring-rose-200'
        } %}

        <ul class="space-y-3">
            {% for dossier in dossiers %}
                {% set t = dossier.type.value %}
                {% set classe_type = type_couleur[t]|default('bg-surface text-ink/60 ring-hairline') %}
                {% set clos = dossier.statut.value == 'clos' %}

                <li class="rounded-md border border-hairline bg-white p-4 {{ clos ? 'opacity-70' : '' }}">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[0.7rem] font-semibold ring-1 ring-inset {{ classe_type }}">
                                    {{ type_libelle[t]|default(t) }}
                                </span>
                                <span class="inline-flex items-center rounded-full bg-{{ clos ? 'surface' : 'emerald-50' }} px-2 py-0.5 text-[0.7rem] font-semibold {{ clos ? 'text-ink/60' : 'text-emerald-700' }}">
                                    {{ dossier.statut.libelle }}
                                </span>
                                <a href="{{ path('app_creances_dossier_voir', { id: dossier.id }) }}"
                                   class="text-sm font-semibold text-navy hover:text-navy-light">
                                    {{ dossier.libelle }}
                                </a>
                            </div>
                            <div class="mt-1 text-[0.7rem] text-ink/55">
                                Ouvert le {{ dossier.dateDebut|date('d/m/Y') }}
                                {% if dossier.dateResolutionCible and not clos %} · Cible {{ dossier.dateResolutionCible|date('d/m/Y') }}{% endif %}
                                {% if clos and dossier.dateResolution %} · Clos le {{ dossier.dateResolution|date('d/m/Y') }}{% endif %}
                                {% if dossier.responsable %} · Responsable {{ dossier.responsable.firstName }} {{ dossier.responsable.lastName }}{% endif %}
                            </div>
                            {% if dossier.description %}
                                <p class="mt-2 text-[0.78rem] text-ink/70 whitespace-pre-line">{{ dossier.description }}</p>
                            {% endif %}

                            {# Resume des ecritures liees #}
                            {% if dossier.ecritures|length > 0 %}
                                <div class="mt-3 flex flex-wrap gap-1.5">
                                    {% for de in dossier.ecritures %}
                                        <span class="inline-flex items-center gap-1 rounded bg-surface px-2 py-0.5 text-[0.7rem] {{ de.resolue ? 'text-emerald-700 line-through' : 'text-ink/70' }}">
                                            <span class="font-mono">{{ de.ecritureNumero }}</span>
                                            {% if de.montantPartiel %}<span class="text-ink/50">· {{ de.montantPartiel|number_format(0, ',', ' ') }} EUR</span>{% endif %}
                                        </span>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {# Resume des echeances (si echeancier) #}
                            {% if t == 'echeancier' and dossier.echeances|length > 0 %}
                                <div class="mt-3 overflow-hidden rounded border border-hairline">
                                    <table class="w-full text-[0.78rem]">
                                        <thead class="bg-surface text-[0.65rem] uppercase tracking-wider text-ink/55">
                                            <tr>
                                                <th class="px-2 py-1 text-left">#</th>
                                                <th class="px-2 py-1 text-left">Date</th>
                                                <th class="px-2 py-1 text-right">Montant</th>
                                                <th class="px-2 py-1 text-right">Regle</th>
                                                <th class="px-2 py-1 text-left">Statut</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for e in dossier.echeances %}
                                                {% set classe_e = {
                                                    'a_venir': 'text-ink/70',
                                                    'partiel': 'text-amber-700',
                                                    'regle': 'text-emerald-700',
                                                    'en_retard': 'text-rose-700'
                                                }[e.statut.value]|default('text-ink/60') %}
                                                <tr class="border-t border-hairline">
                                                    <td class="px-2 py-1 font-mono text-ink/60">{{ e.numero }}</td>
                                                    <td class="px-2 py-1">{{ e.datePrevue|date('d/m/Y') }}</td>
                                                    <td class="px-2 py-1 text-right font-mono">{{ e.montant|number_format(2, ',', ' ') }}</td>
                                                    <td class="px-2 py-1 text-right font-mono {{ classe_e }}">{{ e.montantRegle|number_format(2, ',', ' ') }}</td>
                                                    <td class="px-2 py-1 {{ classe_e }}">{{ e.statut.libelle }}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% endif %}

                            {% if clos and dossier.commentaireResolution %}
                                <div class="mt-2 rounded border border-hairline bg-surface/40 p-2 text-[0.78rem] text-ink/70">
                                    <p class="mb-1 text-[0.65rem] uppercase tracking-wider text-ink/45">Resolution {{ dossier.resultat ? '— ' ~ dossier.resultat : '' }}</p>
                                    <p class="whitespace-pre-line">{{ dossier.commentaireResolution }}</p>
                                </div>
                            {% endif %}
                        </div>
                        {% if dossier.montantTotal %}
                            <div class="shrink-0 text-right">
                                <p class="text-lg font-bold text-navy">{{ dossier.montantTotal|number_format(0, ',', ' ') }} <span class="text-sm text-ink/40">EUR</span></p>
                                <p class="text-[0.65rem] uppercase tracking-wider text-ink/45">Montant total</p>
                            </div>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
