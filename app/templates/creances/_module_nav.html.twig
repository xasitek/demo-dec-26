{# Sous-navigation interne au module Recouvrement. Style raffine,
   onglets fins avec indicateur de selection minimal (1px gold dark).
   Parametre : `actif` = pilotage / liste / priorites / inactifs /
   strategies / modeles / relance / campagnes / rapports / analyses /
   reponses. #}

<style>
    .fc-tab {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.55rem 0.625rem;
        font-size: 0.78rem;
        font-weight: 400;
        color: rgba(14, 37, 64, 0.55);
        border-bottom: 1px solid transparent;
        transition: color 150ms ease, border-color 150ms ease;
        white-space: nowrap;
    }
    .fc-tab:hover { color: #0e2540; }
    .fc-tab.is-active {
        color: #0e2540;
        border-bottom-color: #c5a572;
        font-weight: 500;
    }
    .fc-tab svg { opacity: 0.55; }
    .fc-tab.is-active svg { opacity: 0.85; }
    /* Pas de scroll context (sinon le navigateur recentre la nav au focus) */
    .fc-module-nav { overflow-x: clip; }
</style>

<nav class="fc-module-nav mb-6 flex flex-nowrap items-center border-b border-hairline -mt-1">
    <a href="{{ path('app_creances_pilotage') }}" class="fc-tab {{ actif == 'pilotage' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l2-2 7 7L21 8"/></svg>
        Pilotage
    </a>
    <a href="{{ path('app_creances_index') }}" class="fc-tab {{ actif == 'liste' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        Creances
    </a>
    <a href="{{ path('app_creances_priorites') }}" class="fc-tab {{ actif == 'priorites' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Priorites
    </a>
    <a href="{{ path('app_creances_inactifs') }}" class="fc-tab {{ actif == 'inactifs' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Inactifs
    </a>

    <span class="mx-2 h-4 w-px bg-hairline"></span>

    <a href="{{ path('app_creances_strategies') }}" class="fc-tab {{ actif == 'strategies' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Strategies
    </a>
    <a href="{{ path('app_creances_modeles') }}" class="fc-tab {{ actif == 'modeles' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M4 8h16"/><path d="M8 4v16"/></svg>
        Modeles
    </a>
    <a href="{{ path('app_creances_relance_expert') }}" class="fc-tab {{ actif == 'relance' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
        Relances
    </a>
    <a href="{{ path('app_creances_campagnes') }}" class="fc-tab {{ actif == 'campagnes' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l4-4 4 4 5-5"/></svg>
        Campagnes
    </a>
    <a href="{{ path('app_creances_rapports') }}" class="fc-tab {{ actif == 'rapports' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Rapports
    </a>
    <a href="{{ path('app_creances_analyses') }}" class="fc-tab {{ actif == 'analyses' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"/><polyline points="12 22 12 15.5 22 8.5"/></svg>
        Analyses
    </a>
    <a href="{{ path('app_creances_reponses') }}" class="fc-tab {{ actif == 'reponses' ? 'is-active' : '' }}">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        Retours
    </a>
</nav>
