{% extends 'layout.html.twig' %}

{% block title %}Pilotage - Recouvrement{% endblock %}
{% block page_title %}Recouvrement{% endblock %}

{% block content %}
{% import '_ui.html.twig' as ui %}

{% set etab_opts = {} %}{% for e in etablissements %}{% set etab_opts = etab_opts|merge({ (e): e }) %}{% endfor %}
{# societe retire 2026-06-02 (non disponible dans bal_eloficash) #}

{% set score = indicateurs.score|default(0) %}
{% set score_couleur = score >= 7 ? 'text-emerald-600' : (score >= 5 ? 'text-amber-600' : 'text-rose-600') %}

{# Tranches d'anciennete (libelle + couleur) #}
{% set tranches_meta = [
    { key: '0', libelle: 'Non echu', couleur: 'bg-emerald-500', texte: 'text-emerald-700' },
    { key: '<30',  libelle: '< 30j',  couleur: 'bg-sky-500',    texte: 'text-sky-700' },
    { key: '>30',  libelle: '> 30j',  couleur: 'bg-amber-500',  texte: 'text-amber-700' },
    { key: '>60',  libelle: '> 60j',  couleur: 'bg-orange-500', texte: 'text-orange-700' },
    { key: '>90',  libelle: '> 90j',  couleur: 'bg-red-500',    texte: 'text-red-700' },
    { key: '>120', libelle: '> 120j', couleur: 'bg-rose-500',   texte: 'text-rose-700' },
    { key: '>180', libelle: '> 180j', couleur: 'bg-rose-600',   texte: 'text-rose-800' },
    { key: '>240', libelle: '> 240j', couleur: 'bg-rose-800', texte: 'text-rose-900' }
] %}
{% set max_tranche = 1 %}
{% for tr in tranches_meta %}
    {% set v = balance_agee.tranches[tr.key]|default(0) %}
    {% if v > max_tranche %}{% set max_tranche = v %}{% endif %}
{% endfor %}

<div class="mx-auto max-w-7xl">

    {% include 'creances/_module_nav.html.twig' with { actif: 'pilotage' } %}
    {% include 'creances/_flashes.html.twig' %}

    {# Alerte inactifs #}
    {% if nb_inactifs|default(0) > 0 %}
        <a href="{{ path('app_creances_inactifs') }}"
           class="mb-4 flex items-center justify-between gap-3 rounded-md border border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-700 hover:bg-rose-100 transition-colors">
            <div class="flex items-center gap-2">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
                <span><strong>{{ nb_inactifs }}</strong> compte(s) en creance sans action depuis plus de 15 jours.</span>
            </div>
            <span class="text-[0.7rem] underline">Voir la liste →</span>
        </a>
    {% endif %}

    {# Filtres #}
    <form method="get" class="mb-4 rounded-md border border-hairline bg-white p-4 shadow-sm">
        <div class="fc-filter-section is-source-sage">
            <div class="fc-filter-section-label">Perimetre</div>
            <div class="flex flex-wrap gap-2">
                {{ ui.fc_multi_select('etablissement', etab_opts, filtres.etablissement|default([]), 'Tous les etablissements', 'etablissements') }}
            </div>
        </div>
    </form>

    {# ===== KPI — design fin (separation 1px, pas de cards epaisses) ===== #}
    <div class="mb-6 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-hairline bg-hairline md:grid-cols-4">
        <div class="bg-white px-5 py-5">
            <p class="text-[0.6rem] uppercase tracking-[0.15em] text-ink/40">Encours total</p>
            <p class="mt-2 text-3xl font-light tracking-tight text-navy">{{ indicateurs.encours_total|number_format(0, ',', ' ') }} <span class="text-base text-ink/35">EUR</span></p>
            <p class="mt-1 text-[0.7rem] text-ink/45">{{ pluriel(indicateurs.nb_comptes, 'compte', 'comptes') }}</p>
        </div>
        <div class="bg-white px-5 py-5">
            <p class="text-[0.6rem] uppercase tracking-[0.15em] text-ink/40">Encours echu</p>
            <p class="mt-2 text-3xl font-light tracking-tight text-orange-600">{{ indicateurs.encours_echu|number_format(0, ',', ' ') }} <span class="text-base text-ink/35">EUR</span></p>
            <p class="mt-1 text-[0.7rem] text-ink/45">
                {% if indicateurs.encours_total > 0 %}
                    {{ ((indicateurs.encours_echu / indicateurs.encours_total) * 100)|number_format(1, ',', ' ') }}% du total
                {% else %}—{% endif %}
            </p>
        </div>
        <div class="bg-white px-5 py-5">
            <p class="text-[0.6rem] uppercase tracking-[0.15em] text-ink/40">Encaissement</p>
            <p class="mt-2 text-3xl font-light tracking-tight text-emerald-600">{{ indicateurs.encaissement_mois|number_format(0, ',', ' ') }} <span class="text-base text-ink/35">EUR</span></p>
            <p class="mt-1 text-[0.7rem] text-ink/45">{{ "now"|date('F Y')|lower }}</p>
        </div>
        <div class="bg-white px-5 py-5">
            <p class="text-[0.6rem] uppercase tracking-[0.15em] text-ink/40">DSO</p>
            <p class="mt-2 text-3xl font-light tracking-tight text-navy">{{ indicateurs.dso|number_format(1, ',', ' ') }} <span class="text-base text-ink/35">j</span></p>
            <p class="mt-1 text-[0.7rem] text-ink/45">BPDSO {{ indicateurs.bpdso|number_format(1, ',', ' ') }}j · Retard moyen {{ indicateurs.retard_moyen_jours|number_format(0) }}j</p>
        </div>
    </div>

    {# ===== Score + Balance agee ===== #}
    <div class="mb-4 grid grid-cols-1 gap-3 lg:grid-cols-3">

        {# Score sante (colonne gauche, 1/3) #}
        <div class="rounded-md border border-hairline bg-white p-5 shadow-sm">
            <div class="flex items-baseline justify-between">
                <h3 class="text-sm font-semibold uppercase tracking-wider text-ink/55">Score sante</h3>
                <span class="text-[0.65rem] text-ink/40">0 — 10</span>
            </div>
            <div class="my-4 text-center">
                <p class="text-5xl font-bold {{ score_couleur }}">{{ score|number_format(1, ',', ' ') }}</p>
                <p class="mt-1 text-[0.7rem] text-ink/50">
                    {% if score >= 7 %}Portefeuille sain
                    {% elseif score >= 5 %}A surveiller
                    {% else %}Tension elevee{% endif %}
                </p>
            </div>
            {# Mini-barre de score #}
            <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-surface">
                <div class="h-full {{ score >= 7 ? 'bg-emerald-500' : (score >= 5 ? 'bg-amber-500' : 'bg-rose-500') }}"
                     style="width: {{ (score * 10)|number_format(1, '.', '') }}%"></div>
            </div>
            <p class="mt-3 text-[0.7rem] text-ink/45">Moyenne ponderee des notes ecritures (regle, echu, litige, contentieux, promesse...)</p>
        </div>

        {# Balance agee : histogramme (colonne droite, 2/3) #}
        <div class="rounded-md border border-hairline bg-white p-5 shadow-sm lg:col-span-2">
            <div class="flex items-baseline justify-between">
                <h3 class="text-sm font-semibold uppercase tracking-wider text-ink/55">Balance agee</h3>
                <span class="text-[0.65rem] text-ink/40">Total : {{ balance_agee.total|number_format(0, ',', ' ') }} EUR</span>
            </div>
            <div class="mt-4 space-y-2.5">
                {% for tr in tranches_meta %}
                    {% set v = balance_agee.tranches[tr.key]|default(0) %}
                    {% set pct = max_tranche > 0 ? (v / max_tranche * 100) : 0 %}
                    {% set pct_total = balance_agee.total > 0 ? (v / balance_agee.total * 100) : 0 %}
                    <div>
                        <div class="mb-1 flex items-baseline justify-between text-[0.75rem]">
                            <span class="{{ tr.texte }} font-medium">{{ tr.libelle }}</span>
                            <span class="text-ink/65">
                                <span class="font-mono font-semibold">{{ v|number_format(0, ',', ' ') }}</span>
                                <span class="text-ink/40 ml-2">{{ pct_total|number_format(1, ',', ' ') }}%</span>
                            </span>
                        </div>
                        <div class="h-3 w-full overflow-hidden rounded-full bg-surface">
                            <div class="h-full rounded-full {{ tr.couleur }} transition-all duration-300" style="width: {{ pct|number_format(1, '.', '') }}%"></div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# ===== Top 10 + Mes actions ===== #}
    <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">

        {# Top criticite (gros + vieux) #}
        <div class="rounded-md border border-hairline bg-white shadow-sm">
            <div class="flex items-baseline justify-between border-b border-hairline px-4 py-3">
                <div>
                    <h3 class="text-sm font-semibold uppercase tracking-wider text-ink/55">Comptes prioritaires</h3>
                    <p class="text-[0.7rem] text-ink/45">Score criticite = 45% montant + 35% anciennete + 20% incidents</p>
                </div>
                <a href="{{ path('app_creances_priorites') }}" class="text-[0.7rem] text-navy hover:text-navy-light">
                    Voir tout →
                </a>
            </div>
            {% if top_criticite|default([]) is empty %}
                <p class="p-5 text-sm text-ink/45">Aucun client en creance.</p>
            {% else %}
                <table class="fc-table-comptable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Client</th>
                            <th class="is-num">Encours</th>
                            <th class="is-num">Anciennete</th>
                            <th class="is-num">Criticite</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for c in top_criticite %}
                            {% set couleur = c.score_criticite >= 75 ? 'bg-rose-100 text-rose-700' : (c.score_criticite >= 50 ? 'bg-amber-100 text-amber-700' : 'bg-sky-100 text-sky-700') %}
                            <tr class="cursor-pointer hover:bg-surface/60 transition-colors"
                                onclick="window.location='{{ path('app_creances_fiche', { code: c.compte }) }}'">
                                <td class="text-[0.7rem] font-mono text-ink/45">{{ loop.index }}</td>
                                <td>
                                    <div class="font-medium text-navy text-[0.85rem]">{{ c.nom }}{% if c.prenom %} {{ c.prenom }}{% endif %}</div>
                                    <div class="text-[0.65rem] font-mono text-ink/45">{{ c.compte }}{% if c.codeetab %} · {{ c.codeetab }}{% endif %}</div>
                                </td>
                                <td class="is-num">
                                    <span class="font-mono font-semibold text-navy">{{ c.encours|number_format(0, ',', ' ') }}</span>
                                    <span class="text-[0.65rem] text-ink/40">EUR</span>
                                </td>
                                <td class="is-num text-[0.78rem]">{{ c.anciennete_max_jours }}j</td>
                                <td class="is-num">
                                    <span class="rounded-full px-2 py-0.5 text-[0.7rem] font-semibold {{ couleur }}">
                                        {{ c.score_criticite|number_format(0, '', '') }}
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>

        {# Mes actions a faire #}
        <div class="rounded-md border border-hairline bg-white shadow-sm">
            <div class="flex items-baseline justify-between border-b border-hairline px-4 py-3">
                <h3 class="text-sm font-semibold uppercase tracking-wider text-ink/55">Mes actions a faire</h3>
                {% if mes_actions_en_retard > 0 %}
                    <span class="rounded-full bg-rose-50 px-2 py-0.5 text-[0.65rem] font-semibold text-rose-700">
                        {{ pluriel(mes_actions_en_retard, 'en retard', 'en retard') }}
                    </span>
                {% endif %}
            </div>
            {% if mes_actions is empty %}
                <div class="p-8 text-center">
                    <svg viewBox="0 0 24 24" class="mx-auto h-10 w-10 text-emerald-500" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    <p class="mt-3 text-sm text-ink/55">Aucune action en attente.</p>
                    <p class="text-[0.7rem] text-ink/40">Bon travail.</p>
                </div>
            {% else %}
                <ul class="divide-y divide-hairline">
                    {% for a in mes_actions|slice(0, 8) %}
                        {% set retard = a.enRetard %}
                        <li class="px-4 py-3 hover:bg-surface/30 transition-colors">
                            <a href="{{ path('app_creances_fiche', { code: a.compteCode }) }}#tab=actions" class="block">
                                <div class="flex items-start gap-3">
                                    <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full {{ retard ? 'bg-rose-50 text-rose-700' : 'bg-sky-50 text-sky-700' }}">
                                        <span class="text-[0.7rem] font-bold">{{ a.type.libelle|slice(0, 1) }}</span>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="truncate text-sm font-medium text-navy">{{ a.libelle }}</p>
                                        <p class="text-[0.7rem] text-ink/55">
                                            Compte <span class="font-mono">{{ a.compteCode }}</span>
                                            · {{ a.type.libelle }}
                                            · Echeance {{ a.echeance|date('d/m/Y') }}
                                        </p>
                                    </div>
                                    <div class="shrink-0">
                                        {% if retard %}
                                            <span class="rounded-full bg-rose-50 px-2 py-0.5 text-[0.65rem] font-semibold text-rose-700">En retard</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
                {% if mes_actions|length > 8 %}
                    <p class="border-t border-hairline px-4 py-2 text-center text-[0.7rem] text-ink/45">
                        + {{ mes_actions|length - 8 }} autres a venir
                    </p>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>

{% endblock %}
