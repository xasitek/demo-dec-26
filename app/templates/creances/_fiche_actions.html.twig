{# Onglet "Actions" : actions de relance + promesses de paiement, avec
   formulaires d'ajout et de cloture (CSRF + redirection avec flash). #}

<div class="pt-5">

    {# Widget Strategie de relance affectee #}
    {% set _etat_couleur = {
        'a_relancer': 'bg-amber-50 text-amber-700 ring-amber-200',
        'cours': 'bg-sky-50 text-sky-700 ring-sky-200',
        'desactive': 'bg-surface text-ink/55 ring-hairline',
        'repositionne': 'bg-purple-50 text-purple-700 ring-purple-200',
        'erreur': 'bg-rose-50 text-rose-700 ring-rose-200',
        'fin': 'bg-emerald-50 text-emerald-700 ring-emerald-200'
    } %}
    <div class="mb-5 rounded-md border border-hairline bg-white p-3">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
                <p class="text-[0.7rem] uppercase tracking-wider text-ink/55">Strategie de relance</p>
                {% if compte_strategie is defined and compte_strategie and compte_strategie.strategie %}
                    {% set _strat = compte_strategie.strategie %}
                    <div class="mt-1 flex flex-wrap items-center gap-2">
                        <a href="{{ path('app_creances_strategie_voir', { id: _strat.id }) }}" class="text-sm font-semibold text-navy hover:text-navy-light">{{ _strat.libelle }}</a>
                        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[0.65rem] font-semibold ring-1 ring-inset {{ _etat_couleur[compte_strategie.etat.value]|default('bg-surface text-ink/55 ring-hairline') }}">
                            {{ compte_strategie.etat.libelle }}
                        </span>
                    </div>
                    <p class="mt-1 text-[0.7rem] font-medium text-ink/65">
                        Niveau courant : {{ compte_strategie.niveauCourant }}{% if _strat.niveaux|length > 0 %} / {{ _strat.niveaux|length }}{% endif %}
                        {% if compte_strategie.dateDerniereRelance %} · Derniere relance {{ compte_strategie.dateDerniereRelance|date('d/m/Y') }}{% endif %}
                        {% if compte_strategie.repositionneJusquAu %} · Repositionnee jusqu'au {{ compte_strategie.repositionneJusquAu|date('d/m/Y') }}{% endif %}
                    </p>
                    {% if compte_strategie.erreurMessage %}
                        <p class="mt-1 rounded bg-rose-50 px-2 py-1 text-[0.7rem] text-rose-700">Erreur : {{ compte_strategie.erreurMessage }}</p>
                    {% endif %}
                {% else %}
                    <p class="mt-1 text-sm text-ink/45">Aucune strategie affectee (relance manuelle uniquement).</p>
                {% endif %}
            </div>

            {# Boutons de gestion strategie : selecteur + repositionner #}
            <div class="flex shrink-0 flex-col items-end gap-1">
                <details>
                    <summary class="cursor-pointer text-[0.7rem] text-navy hover:text-navy-light underline list-none">Changer / affecter une strategie</summary>
                    <form method="post" action="{{ path('app_creances_affecter_strategie', { code: compte_code }) }}"
                          class="mt-2 w-64 rounded-md border border-hairline bg-surface/40 p-2 space-y-1">
                        <input type="hidden" name="_token" value="{{ csrf_token('creances_affecter_strategie_' ~ compte_code) }}">
                        <label class="block text-[0.65rem] text-ink/55">Strategie</label>
                        <select name="strategie_id" class="w-full rounded-md border border-hairline px-2 py-1 text-[0.78rem]">
                            <option value="0">— Aucune (relance manuelle) —</option>
                            {% for s in strategies_disponibles|default([]) %}
                                <option value="{{ s.id }}" {{ compte_strategie is defined and compte_strategie and compte_strategie.strategie and compte_strategie.strategie.id == s.id ? 'selected' }}>{{ s.libelle }}</option>
                            {% endfor %}
                        </select>
                        <button type="submit" class="mt-1 w-full rounded border border-navy bg-navy px-2 py-1 text-[0.7rem] font-medium text-white hover:bg-navy-light">Enregistrer</button>
                    </form>
                </details>
                {% if compte_strategie is defined and compte_strategie and compte_strategie.strategie %}
                    <details>
                        <summary class="cursor-pointer text-[0.7rem] text-navy hover:text-navy-light underline list-none">Repositionner la relance</summary>
                        <form method="post" action="{{ path('app_creances_repositionner', { code: compte_code }) }}"
                              class="mt-2 w-64 rounded-md border border-hairline bg-surface/40 p-2 space-y-1">
                            <input type="hidden" name="_token" value="{{ csrf_token('creances_repositionner_' ~ compte_code) }}">
                            <label class="block text-[0.65rem] text-ink/55">Jusqu'au (vide = effacer)</label>
                            <input type="date" name="jusqu_au" min="{{ "today"|date('Y-m-d') }}"
                                   class="w-full rounded-md border border-hairline px-2 py-1 text-[0.78rem]">
                            <button type="submit" class="mt-1 w-full rounded border border-navy bg-navy px-2 py-1 text-[0.7rem] font-medium text-white hover:bg-navy-light">Appliquer</button>
                        </form>
                    </details>
                {% endif %}
            </div>
        </div>
    </div>

    {# Alerter equipe interne (secretaire qui a saisi la facture, vendeur, directeur) #}
    <details class="mb-5 rounded-md border border-amber-300 bg-amber-50 p-3">
        <summary class="cursor-pointer text-sm font-semibold text-amber-900 list-none">
            <svg viewBox="0 0 24 24" class="inline-block h-4 w-4 -mt-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
            Alerter l'equipe interne (secretaire / vendeur / directeur)
        </summary>
        <form method="post" action="{{ path('app_creances_alerter_interne', { code: compte_code }) }}" class="mt-3 space-y-2">
            <input type="hidden" name="_token" value="{{ csrf_token('creances_alerter_interne_' ~ compte_code) }}">

            {% if destinataires_internes|default([]) is not empty %}
                <p class="text-[0.65rem] uppercase tracking-wider text-amber-900/70">Destinataires connus (Progiciel)</p>
                <div class="flex flex-wrap gap-1.5">
                    {% for d in destinataires_internes %}
                        <button type="button"
                                onclick="const f=document.getElementById('alerter-emails-{{ compte_code }}');f.value=(f.value?f.value+', ':'')+'{{ d.email }}';return false;"
                                class="rounded-full bg-white px-2 py-0.5 text-[0.7rem] text-amber-900 ring-1 ring-amber-300 hover:bg-amber-100">
                            + {{ d.role }} : {{ d.email }}
                        </button>
                    {% endfor %}
                </div>
            {% endif %}

            <div>
                <label class="block text-[0.7rem] text-amber-900/70">Destinataires (emails separes par virgule)</label>
                <input type="text" id="alerter-emails-{{ compte_code }}" name="emails" required
                       placeholder="secretaire@demonstration.invalid, vendeur@demonstration.invalid"
                       class="w-full rounded-md border border-amber-300 px-2 py-1.5 text-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-300/30">
            </div>
            <div>
                <label class="block text-[0.7rem] text-amber-900/70">Commentaire / consigne</label>
                <textarea name="commentaire" rows="3" required maxlength="2000"
                          placeholder="Ex: Peux-tu appeler le client ce matin pour comprendre pourquoi le reglement traine ?"
                          class="w-full rounded-md border border-amber-300 px-2 py-1.5 text-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-300/30"></textarea>
            </div>
            <p class="text-[0.65rem] text-amber-900/60">
                Un email avec le resume du compte (encours, vehicules, ecritures, lien fiche) + ton commentaire sera envoye aux destinataires. L'envoi est trace dans l'historique des actions.
            </p>
            <div class="flex justify-end">
                <button type="submit" class="rounded-md border border-amber-700 bg-amber-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-amber-800">
                    Envoyer l'alerte interne
                </button>
            </div>
        </form>
    </details>

    {# Formulaire d'ajout d'action #}
    <form method="post"
          action="{{ path('app_creances_action_creer', { code: compte_code }) }}"
          class="mb-6 border-l-2 border-navy/15 pl-4">
        <input type="hidden" name="_token" value="{{ csrf_token('creances_action_' ~ compte_code) }}">
        <p class="mb-3 text-[0.65rem] font-medium uppercase tracking-[0.12em] text-navy">Planifier une action</p>
        <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
            <div>
                <label class="block text-[0.7rem] font-medium text-ink/65">Type</label>
                <select name="type" required class="w-full rounded-md border border-hairline px-2 py-1.5 text-sm focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/30">
                    <option value="telephone">Appel telephonique</option>
                    <option value="email">E-mail</option>
                    <option value="courrier">Courrier postal</option>
                    <option value="sms">SMS</option>
                    <option value="visite">Visite client</option>
                    <option value="autre">Autre</option>
                </select>
            </div>
            <div>
                <label class="block text-[0.7rem] font-medium text-ink/65">Echeance</label>
                <input type="date" name="echeance" required value="{{ "now"|date('Y-m-d') }}"
                       class="w-full rounded-md border border-hairline px-2 py-1.5 text-sm focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/30">
            </div>
            <div class="md:col-span-2">
                <label class="block text-[0.7rem] font-medium text-ink/65">Libelle</label>
                <input type="text" name="libelle" required maxlength="255" placeholder="Ex: Appeler le client pour relance"
                       class="w-full rounded-md border border-hairline px-2 py-1.5 text-sm focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/30">
            </div>
            <div class="md:col-span-2">
                <label class="block text-[0.7rem] font-medium text-ink/65">Description (optionnel)</label>
                <textarea name="description" rows="2" maxlength="2000"
                          class="w-full rounded-md border border-hairline px-2 py-1.5 text-sm focus:border-navy focus:outline-none focus:ring-2 focus:ring-navy/30"></textarea>
            </div>
        </div>
        <div class="mt-2 flex justify-end">
            <button type="submit" class="inline-flex items-center gap-1.5 rounded-md border border-navy bg-navy px-3 py-1.5 text-sm font-medium text-white transition hover:bg-navy-light">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                Ajouter l'action
            </button>
        </div>
    </form>

    {# Promesses #}
    <div class="mb-6">
        <div class="mb-3 flex items-center justify-between">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-ink/60">Promesses de paiement</h3>
            <span class="rounded-full bg-surface px-2 py-0.5 text-[0.7rem] font-medium text-ink/60">{{ pluriel(promesses|length, 'promesse', 'promesses') }}</span>
        </div>
        {% if promesses is empty %}
            <p class="text-sm text-ink/45">Aucune promesse enregistree pour ce tiers.</p>
        {% else %}
            <div class="overflow-hidden rounded-md border border-hairline">
                <table class="fc-table-comptable">
                    <thead>
                        <tr>
                            <th>Date promise</th>
                            <th>Ecriture</th>
                            <th class="is-num">Montant</th>
                            <th>Statut</th>
                            <th>Auteur</th>
                            <th>Saisie</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for p in promesses %}
                            {% set statut_classe = {
                                'en_cours': p.echue ? 'bg-rose-50 text-rose-700' : 'bg-amber-50 text-amber-700',
                                'tenue': 'bg-emerald-50 text-emerald-700',
                                'non_tenue': 'bg-rose-50 text-rose-700',
                                'annulee': 'bg-surface text-ink/60'
                            }[p.statut.value] %}
                            <tr>
                                <td class="text-[0.78rem]">{{ p.datePromesse|date('d/m/Y') }}</td>
                                <td class="font-mono text-[0.78rem] text-ink/80">{{ p.ecritureNumero }}</td>
                                <td class="is-num font-mono">
                                    {% if p.montant %}{{ p.montant|number_format(2, ',', ' ') }} EUR{% else %}<span class="text-ink/30">Totalite</span>{% endif %}
                                </td>
                                <td>
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[0.7rem] font-semibold {{ statut_classe }}">
                                        {{ p.statut.libelle }}{% if p.echue %} (echue){% endif %}
                                    </span>
                                </td>
                                <td class="text-[0.78rem] text-ink/70">{{ p.auteur ? (p.auteur.firstName ~ ' ' ~ p.auteur.lastName) : '—' }}</td>
                                <td class="text-[0.78rem] text-ink/60">{{ p.creeLe|date('d/m/Y H:i') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    {# Actions de relance #}
    <div>
        <div class="mb-3 flex items-center justify-between">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-ink/60">Actions de relance</h3>
            <span class="rounded-full bg-surface px-2 py-0.5 text-[0.7rem] font-medium text-ink/60">{{ pluriel(actions|length, 'action', 'actions') }}</span>
        </div>
        {% if actions is empty %}
            <p class="text-sm text-ink/45">Aucune action enregistree pour ce tiers.</p>
        {% else %}
            <ul class="space-y-3">
                {% for a in actions %}
                    {% set icone = {
                        'telephone': '<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
                        'email': '<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>',
                        'courrier': '<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>',
                        'sms': '<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
                        'visite': '<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>'
                    }[a.type.value]|default('<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/></svg>') %}

                    {% set retard = a.enRetard %}
                    <li class="rounded-md border border-hairline bg-white p-3 {{ retard ? 'ring-1 ring-rose-200' : '' }}">
                        <div class="flex items-start gap-3">
                            <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full {{ a.realisee ? 'bg-emerald-50 text-emerald-700' : (retard ? 'bg-rose-50 text-rose-700' : 'bg-sky-50 text-sky-700') }}">
                                {{ icone|raw }}
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-start justify-between gap-2">
                                    <div>
                                        <p class="text-sm font-medium text-navy">{{ a.libelle }}</p>
                                        <p class="mt-0.5 text-[0.7rem] font-medium text-ink/65">
                                            {{ a.type.libelle }}
                                            · Echeance {{ a.echeance|date('d/m/Y') }}
                                            {% if a.destinataire %}· Pour {{ a.destinataire.firstName }} {{ a.destinataire.lastName }}{% endif %}
                                            {% if a.ecritureNumero %}· Sur ecriture <span class="font-mono">{{ a.ecritureNumero }}</span>{% endif %}
                                        </p>
                                    </div>
                                    <div class="shrink-0 text-right">
                                        {% if a.realisee %}
                                            <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-[0.7rem] font-semibold text-emerald-700">Realisee</span>
                                            {% if a.resultat %}<p class="mt-1 text-[0.65rem] text-ink/55">{{ a.resultat.libelle }}</p>{% endif %}
                                        {% elseif retard %}
                                            <span class="inline-flex items-center rounded-full bg-rose-50 px-2 py-0.5 text-[0.7rem] font-semibold text-rose-700">En retard</span>
                                        {% else %}
                                            <span class="inline-flex items-center rounded-full bg-sky-50 px-2 py-0.5 text-[0.7rem] font-semibold text-sky-700">A faire</span>
                                        {% endif %}
                                    </div>
                                </div>
                                {% if a.description %}
                                    <p class="mt-2 text-[0.78rem] text-ink/70 whitespace-pre-line">{{ a.description }}</p>
                                {% endif %}
                                {% if a.realisee and a.commentaireResultat %}
                                    <div class="mt-2 rounded border border-hairline bg-surface/40 p-2 text-[0.78rem] text-ink/70">
                                        <p class="mb-1 text-[0.65rem] uppercase tracking-wider text-ink/45">Resultat</p>
                                        <p class="whitespace-pre-line">{{ a.commentaireResultat }}</p>
                                    </div>
                                {% endif %}

                                {# Formulaire de cloture (si non realisee) ou de reouverture (si realisee). #}
                                {% if not a.realisee %}
                                    <details class="mt-2 group">
                                        <summary class="cursor-pointer text-[0.7rem] font-medium text-navy hover:text-navy-light list-none">
                                            <span class="inline-flex items-center gap-1">
                                                <svg viewBox="0 0 24 24" class="h-3 w-3 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                                                Cloturer cette action
                                            </span>
                                        </summary>
                                        <form method="post"
                                              action="{{ path('app_creances_action_cloturer', { id: a.id }) }}"
                                              class="mt-2 rounded border border-hairline bg-surface/40 p-2 space-y-2">
                                            <input type="hidden" name="_token" value="{{ csrf_token('creances_action_cloturer_' ~ a.id) }}">
                                            <div>
                                                <label class="block text-[0.65rem] text-ink/55">Resultat</label>
                                                <select name="resultat" required class="w-full rounded-md border border-hairline px-2 py-1 text-[0.78rem]">
                                                    <option value="contact_ok">Contact etabli</option>
                                                    <option value="contact_ko">Pas de contact</option>
                                                    <option value="promesse">Promesse obtenue</option>
                                                    <option value="refus">Refus</option>
                                                    <option value="litige">Litige declare</option>
                                                    <option value="reglement">Reglement</option>
                                                    <option value="autre">Autre</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label class="block text-[0.65rem] text-ink/55">Commentaire (optionnel)</label>
                                                <textarea name="commentaire" rows="2" maxlength="2000"
                                                          class="w-full rounded-md border border-hairline px-2 py-1 text-[0.78rem]"></textarea>
                                            </div>
                                            <div class="flex justify-end">
                                                <button type="submit" class="rounded-md border border-emerald-600 bg-emerald-600 px-2 py-1 text-[0.7rem] font-medium text-white hover:bg-emerald-700">Enregistrer la cloture</button>
                                            </div>
                                        </form>
                                    </details>
                                {% else %}
                                    <form method="post" action="{{ path('app_creances_action_rouvrir', { id: a.id }) }}" class="mt-2 inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('creances_action_rouvrir_' ~ a.id) }}">
                                        <button type="submit" class="text-[0.65rem] text-ink/45 hover:text-navy underline">Rouvrir cette action</button>
                                    </form>
                                {% endif %}

                                <p class="mt-2 text-[0.65rem] text-ink/40">
                                    Saisie par {{ a.auteur ? (a.auteur.firstName ~ ' ' ~ a.auteur.lastName) : 'utilisateur inconnu' }}
                                    le {{ a.creeLe|date('d/m/Y H:i') }}
                                </p>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
