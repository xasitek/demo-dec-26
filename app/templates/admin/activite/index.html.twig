{% extends 'layout.html.twig' %}

{% macro duree(s) %}
{%- set h = (s // 3600) -%}
{%- set m = ((s % 3600) // 60) -%}
{%- if s <= 0 -%}—
{%- elseif h > 0 -%}{{ h }} h{% if m > 0 %} {{ '%02d'|format(m) }}{% endif %}
{%- else -%}{{ m }} min
{%- endif -%}
{% endmacro %}

{% import _self as fmt %}

{% block title %}Journal d'activité - Finance Créances{% endblock %}
{% block page_title %}{% if cible %}Activité · {{ cible.fullName }}{% else %}Journal d'activité{% endif %}{% endblock %}

{% block content %}
<div class="mx-auto max-w-4xl">
    {% if cible %}
        <div class="mb-5 flex flex-wrap items-center gap-2">
            <a href="{{ path('app_admin_users') }}" class="text-sm text-ink/60 hover:text-navy">&larr; Utilisateurs</a>
            <span class="text-ink/30">&middot;</span>
            <span class="text-sm font-semibold text-navy">{{ cible.fullName }}</span>

            <form method="post" action="{{ path('app_admin_activite_visibilite', { id: cible.id }) }}" class="ml-auto">
                <input type="hidden" name="_token" value="{{ csrf_token('presence_visibilite') }}">
                <button type="submit" title="Affichage dans la pile d'avatars de présence"
                        class="inline-flex items-center gap-2 rounded-lg border px-3 py-1.5 text-sm font-medium transition {{ cible.presenceVisible ? 'border-positive/30 bg-positive/10 text-positive hover:bg-positive/20' : 'border-ink/15 bg-surface text-ink/60 hover:bg-ink/10' }}">
                    <span class="h-2 w-2 rounded-full {{ cible.presenceVisible ? 'bg-positive' : 'bg-ink/30' }}"></span>
                    Présence : {{ cible.presenceVisible ? 'Affiché' : 'Masqué' }}
                </button>
            </form>
        </div>

        {# Selecteur de periode #}
        <div class="mb-5 flex items-center gap-1.5">
            {% for j in jours_options %}
                <a href="{{ path('app_admin_activite', { user: cible.id, jours: j }) }}"
                   class="rounded-lg px-3 py-1.5 text-sm font-medium transition {{ stats.jours == j ? 'bg-navy text-white' : 'bg-surface text-ink/70 hover:bg-ink/10' }}">{{ j }} jours</a>
            {% endfor %}
        </div>

        {# Indicateurs cles #}
        <div class="mb-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
            <div class="rounded-lg border border-ink/10 bg-white p-4">
                <p class="text-xs uppercase tracking-wide text-ink/50">Temps actif total</p>
                <p class="mt-1 text-2xl font-bold text-navy">{{ fmt.duree(stats.total) }}</p>
            </div>
            <div class="rounded-lg border border-ink/10 bg-white p-4">
                <p class="text-xs uppercase tracking-wide text-ink/50">Moyenne / jour actif</p>
                <p class="mt-1 text-2xl font-bold text-navy">{{ fmt.duree(stats.moyenne) }}</p>
            </div>
            <div class="rounded-lg border border-ink/10 bg-white p-4">
                <p class="text-xs uppercase tracking-wide text-ink/50">Jours actifs</p>
                <p class="mt-1 text-2xl font-bold text-navy">{{ stats.joursActifs }}<span class="text-base font-normal text-ink/40"> / {{ stats.jours }}</span></p>
            </div>
            <div class="rounded-lg border border-ink/10 bg-white p-4">
                <p class="text-xs uppercase tracking-wide text-ink/50">Connexions</p>
                <p class="mt-1 text-2xl font-bold text-navy">{{ stats.connexions }}</p>
            </div>
        </div>

        {# Graphique : temps actif par jour #}
        <section class="mb-8">
            <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-ink/60">Temps actif par jour</h2>
            <div class="rounded-lg border border-ink/10 bg-white p-4">
                {% if stats.total > 0 %}
                    <div class="flex h-40 items-end gap-px">
                        {% for point in stats.serie %}
                            {% set h = point.secondes > 0 ? max(point.secondes * 100 // stats.max, 4) : 0 %}
                            <div class="flex flex-1 items-end self-stretch" title="{{ point.jour|date('d/m/Y') }} : {{ fmt.duree(point.secondes) }} · moyenne {{ fmt.duree(stats.moyenne) }}">
                                <div class="w-full rounded-t {{ point.secondes > 0 ? 'bg-navy/80 hover:bg-navy' : '' }}" style="height: {{ h }}%"></div>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="mt-2 flex justify-between text-xs text-ink/40">
                        <span>{{ (stats.serie|first).jour|date('d/m') }}</span>
                        <span>{{ (stats.serie|last).jour|date('d/m') }}</span>
                    </div>
                {% else %}
                    <p class="py-8 text-center text-sm text-ink/50">Aucune activité sur la période.</p>
                {% endif %}
            </div>
        </section>
    {% endif %}

    <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-ink/60">Journal des connexions</h2>
    <div data-controller="infinite-scroll"
         data-infinite-scroll-url-value="{{ path('app_admin_activite', cible ? { user: cible.id } : {}) }}"
         data-infinite-scroll-page-value="{{ page }}"
         data-infinite-scroll-total-pages-value="{{ total_pages }}"
         data-infinite-scroll-manual-value="true">
        <div data-infinite-scroll-target="items" class="space-y-2">
            {% include 'admin/activite/_rows.html.twig' %}
        </div>
        <p data-infinite-scroll-target="loading" class="mt-4 text-center text-sm text-ink/50" style="display:none">Chargement...</p>
        {% if total_pages > 1 %}
            <div class="mt-4 text-center">
                <button type="button" data-action="infinite-scroll#loadMore" data-infinite-scroll-target="trigger"
                        class="rounded-lg border border-ink/15 bg-white px-5 py-2 text-sm font-medium text-navy transition hover:bg-surface">Voir plus</button>
            </div>
        {% endif %}
    </div>

    <p class="mt-4 text-center text-xs text-ink/40">{{ pluriel(total, 'événement', 'événements') }}</p>
</div>
{% endblock %}
