<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Finance Creances - Demonstration DEC{% endblock %}</title>
        <link rel="icon" href="{{ asset('favicon.jpg') }}" type="image/jpeg">

        {# DEMONSTRATION : aucune ressource distante. La police du systeme est
           utilisee telle quelle, ce qui garantit que la copie fonctionne meme
           reseau coupe. #}
        <meta name="robots" content="noindex, nofollow, noarchive">
        <style>
        :root{--police-suite:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif}
        body{font-family:var(--police-suite)}
        /* Bandeau de demonstration. Il reprend la palette de la suite : navy
           profond, accent or, et le brun de mise en garde pour la mention. */
        .bandeau-demo{position:sticky;top:0;z-index:60;display:flex;align-items:center;gap:.7rem;
          background:#232740;color:#fff;font:500 11.5px/1.4 var(--police-suite);
          padding:.4rem .9rem;border-bottom:1px solid rgba(200,170,115,.35)}
        .bandeau-demo b{font-weight:700}
        .bandeau-demo__mention{display:inline-flex;align-items:center;gap:.45rem;
          background:#7c2d12;border-radius:4px;padding:.2rem .5rem;letter-spacing:.04em;
          text-transform:uppercase;font-size:10.5px;white-space:nowrap}
        .bandeau-demo__sub{text-transform:none;letter-spacing:0;font-weight:400;opacity:.85}
        .bandeau-demo__sep{width:1px;height:16px;background:rgba(255,255,255,.18)}
        .bandeau-demo__profil{display:inline-flex;align-items:center;gap:.4rem;white-space:nowrap}
        .bandeau-demo__outil{color:#E5D4B0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .bandeau-demo__puce{display:inline-grid;place-content:center;width:17px;height:17px;
          border-radius:50%;font-size:8.5px;font-weight:700;color:#fff;flex:0 0 auto}
        .bandeau-demo__actions{margin-left:auto;display:flex;align-items:center;gap:.35rem}
        .bandeau-demo__btn{display:inline-block;padding:.24rem .55rem;border-radius:5px;
          border:1px solid rgba(255,255,255,.22);color:#fff;text-decoration:none;
          font:600 11px/1.4 var(--police-suite);background:transparent;cursor:pointer;white-space:nowrap}
        .bandeau-demo__btn:hover{background:rgba(255,255,255,.12);border-color:rgba(200,170,115,.6)}
        .bandeau-demo__btn--reset{border-color:rgba(200,170,115,.45);color:#E5D4B0}
        .bandeau-demo__vc{position:relative}
        .bandeau-demo__menu{position:absolute;right:0;top:calc(100% + 6px);min-width:210px;
          background:#fff;border:1px solid #E5E5E5;border-radius:8px;padding:.25rem;
          box-shadow:0 10px 30px rgba(35,39,64,.22);z-index:70}
        .bandeau-demo__menu a{display:flex;align-items:center;gap:.5rem;padding:.4rem .5rem;
          border-radius:6px;color:#4A4A4A;text-decoration:none;font:500 12px/1.3 var(--police-suite)}
        .bandeau-demo__menu a:hover{background:#F5F5F5;color:#2D3250}
        </style>

        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% include 'demo/_bandeau.html.twig' %}
        {% block body %}{% endblock %}
    </body>
</html>
