{#- Lignes de la table « Lettrage » (page initiale + tranches du scroll infini).
    Attend : lignes (list de v_lettrage). -#}
{% for l in lignes %}
    {% set enRetard = l.jours is not null and l.jours > 30 %}
    <tr class="cursor-pointer border-t border-hairline/70 align-top transition hover:bg-gold/[0.05]"
        data-lettrage-cle-param="{{ l.cle_ecriture }}" data-action="click->lettrage#rapprocher">
        <td class="px-3 py-2.5">
            {% if l.type == 'RBC' %}
                <span class="inline-flex items-center rounded-full bg-sky-100 px-2 py-0.5 text-[11px] font-bold text-sky-800" title="Rachat sec">RS</span>
            {% else %}
                <span class="inline-flex items-center rounded-full bg-orange-100 px-2 py-0.5 text-[11px] font-bold text-orange-800" title="Trop-perçu">TP</span>
            {% endif %}
        </td>
        <td class="whitespace-nowrap px-3 py-2.5">
            <span class="inline-flex items-center rounded px-1.5 py-0.5 text-[11px] font-bold {{ enRetard ? 'bg-negative/12 text-negative' : 'bg-positive/12 text-positive' }}">{{ l.retard ?: '—' }}</span>
            {% if l.jours is not null %}<span class="ml-1 text-[11px] text-ink/45">{{ l.jours }} j</span>{% endif %}
        </td>
        <td class="whitespace-nowrap px-3 py-2.5 text-xs text-ink/70">{{ l.date_piece ? l.date_piece|date('d/m/Y') : '—' }}</td>
        <td class="px-3 py-2.5 text-xs">
            <span class="font-mono font-semibold text-navy">{{ l.codeetab ?: '—' }}</span>
            {% if l.etablissement %}<span class="mt-0.5 block text-ink/55">{{ l.etablissement }}</span>{% endif %}
        </td>
        <td class="px-3 py-2.5 text-sm">
            <span class="font-medium text-navy">{{ l.nom ?: '—' }}</span>
            <span class="mt-0.5 block font-mono text-[11px] text-ink/45">{{ l.compte }}</span>
        </td>
        <td class="px-3 py-2.5 text-xs text-ink/70">
            {{ l.libelle_court ?: l.libelle }}
            <span class="mt-0.5 block font-mono text-[11px] text-ink/40">{{ l.numpiece }}</span>
        </td>
        <td class="whitespace-nowrap px-3 py-2.5 text-right text-sm font-bold tabular-nums text-navy">{{ l.montant|number_format(2, ',', ' ') }} <span class="text-xs font-semibold text-gold">€</span></td>
        <td class="whitespace-nowrap px-3 py-2.5 font-mono text-[11px] text-ink/60">{{ l.numimmat ?: l.numvin ?: '—' }}</td>
        {# stopper : le clic sur "Commenter" ne doit pas aussi ouvrir le rapprochement. #}
        <td class="w-[22rem] px-3 py-2" data-action="click->lettrage#stopper">{% include 'remboursement/_lettrage_commentaire.html.twig' with { l: l } only %}</td>
    </tr>
{% endfor %}
