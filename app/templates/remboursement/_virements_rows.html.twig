{#- Lignes du tableau Virements SEPA (partagees : sections + tranches du scroll infini).
   Attend : dossiers, meta (par id), etabs, traite (bool). -#}
{% for d in dossiers %}
    {% set m = meta[d.id] %}
    {% set e = ecarts[d.id]|default(null) %}
    {% set alerte = m.doublon or m.anomalies is not empty or (e and e.diverge) %}
    <tr class="border-t border-hairline/70 transition hover:bg-surface/40 {{ alerte ? 'cursor-pointer bg-amber-50/30 hover:bg-amber-100/60' }}"
        data-dossier-id="{{ d.id }}" data-ref="{{ d.reference }}"{% if m.cleDoublon %} data-cle="{{ m.cleDoublon }}"{% endif %}{% if alerte %} data-action="click->virement#ouvrirDetail"
        data-client="{{ (d.valideNom ?: d.nomClient) ?: '—' }}"
        data-etab="{{ etabs[d.etablissementCode]|default(d.etablissementCode ?: '—') }}"
        data-montant="{{ (d.valideMontant ?: d.montant)|number_format(2, ',', ' ') }} €"
        data-immat="{{ m.immatIcar ?: '—' }}"
        data-iban="{{ m.ibanMasque }}"
        data-bic="{{ m.bic }}"
        data-anomalies="{{ m.anomalies|json_encode }}"
        data-doublons="{{ m.doublonJumeaux|json_encode }}"{% endif %}>
        {% if select|default(false) %}<td class="px-4 py-2.5"><input type="checkbox" name="ids[]" value="{{ d.id }}" checked class="h-4 w-4 rounded border-hairline text-navy focus:ring-2 focus:ring-navy/30"></td>{% endif %}
        <td class="px-4 py-2.5">
            <div class="font-mono text-xs text-navy">{{ d.reference }}</div>
            <div class="mt-0.5 max-w-[15rem] truncate font-mono text-[10px] text-ink/40" title="{{ m.libelle }}">{{ m.libelle }}</div>
        </td>
        <td class="px-4 py-2.5">{{ (d.valideNom ?: d.nomClient) ?: '—' }}</td>
        <td class="px-4 py-2.5 text-xs text-ink/70">{{ etabs[d.etablissementCode]|default(d.etablissementCode ?: '—') }}</td>
        <td class="whitespace-nowrap px-4 py-2.5 font-mono text-xs text-ink/70">{{ m.immatIcar ?: '—' }}</td>
        <td class="whitespace-nowrap px-4 py-2.5">
            <div class="font-mono text-xs text-ink">{{ m.ibanMasque }}</div>
            <div class="font-mono text-[10px] text-ink/45">{{ m.bic }}</div>
        </td>
        <td class="whitespace-nowrap px-4 py-2.5 text-right font-medium text-navy">{{ (d.valideMontant ?: d.montant)|number_format(2, ',', ' ') }} €</td>
        <td class="px-4 py-2.5">
            <div class="flex flex-wrap gap-1">
                {% for a in m.anomalies %}<span class="inline-flex rounded-full bg-red-100 px-2 py-0.5 text-[10px] font-semibold text-red-700">{{ a }}</span>{% endfor %}
                {% if m.doublon %}
                    <button type="button" data-action="virement#voirDoublon" data-cle="{{ m.cleDoublon }}"
                            title="Même bénéficiaire que : {{ m.doublonRefs|join(', ') }}"
                            class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-800 transition hover:bg-amber-200">
                        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg>
                        Doublon{% if m.doublonRefs|length >= 1 %} ({{ m.doublonRefs|length + 1 }}){% endif %}
                    </button>
                {% endif %}
                {% if e and e.iban.diverge %}
                    <span title="IBAN — Saisie : {{ e.iban.saisie ?: '—' }} · Lu : {{ e.iban.ia ?: '—' }} · Validé : {{ e.iban.valide ?: '—' }}"
                          class="inline-flex items-center gap-1 rounded-full bg-orange-100 px-2 py-0.5 text-[10px] font-semibold text-orange-800">
                        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                        IBAN modifié
                    </span>
                {% endif %}
                {% if e and e.montant.diverge %}
                    <span title="Montant — Saisie : {{ e.montant.saisie ?: '—' }} · Lu : {{ e.montant.ia ?: '—' }} · Validé : {{ e.montant.valide ?: '—' }}"
                          class="inline-flex items-center gap-1 rounded-full bg-orange-100 px-2 py-0.5 text-[10px] font-semibold text-orange-800">
                        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                        Montant modifié
                    </span>
                {% endif %}
                {% if not m.doublon and m.anomalies is empty and not (e and e.diverge) %}<span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-700"><svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>OK</span>{% endif %}
            </div>
        </td>
        <td class="whitespace-nowrap px-4 py-2.5 text-xs text-ink/55">
            {% if traite %}{{ d.sepaTelechargeLe|date('d/m/Y à H:i') }}{% if d.sepaTelechargePar %}<div class="text-ink/40">{{ d.sepaTelechargePar }}</div>{% endif %}{% else %}{{ (d.valideDirecteurLe ?: d.deposeLe ?: d.creeLe)|date('d/m/Y') }}{% endif %}
        </td>
    </tr>
{% endfor %}
