{#- Panneau « rapprochement » d'une ligne a lettrer : le dossier paye le plus probable.
    Attend : l (ligne de v_lettrage), candidat ({dossier, score, raisons}|null), nbPayes. -#}
{% import 'remboursement/_statut_badge.html.twig' as badges %}

{# Rappel de la ligne bancaire : ce qu'on cherche a rapprocher. #}
<div class="border-b border-hairline bg-surface/60 px-5 py-4">
    <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
            <div class="flex items-center gap-2">
                {% if l.type == 'RBC' %}
                    <span class="inline-flex items-center rounded-full bg-sky-100 px-2 py-0.5 text-[11px] font-bold text-sky-800">RS</span>
                {% else %}
                    <span class="inline-flex items-center rounded-full bg-orange-100 px-2 py-0.5 text-[11px] font-bold text-orange-800">TP</span>
                {% endif %}
                <span class="truncate text-sm font-semibold text-navy">{{ l.nom ?: l.compte }}</span>
            </div>
            <p class="mt-1 text-xs text-ink/60">{{ l.libelle_court ?: l.libelle }}</p>
            <p class="mt-0.5 font-mono text-[11px] text-ink/45">
                {{ l.numpiece }} · {{ l.codeetab }}{% if l.etablissement %} {{ l.etablissement }}{% endif %}
                {%- if l.date_piece %} · {{ l.date_piece|date('d/m/Y') }}{% endif %}
            </p>
        </div>
        <span class="shrink-0 text-right text-sm font-bold tabular-nums text-navy">{{ l.montant|number_format(2, ',', ' ') }} <span class="text-xs text-gold">€</span></span>
    </div>
</div>

<div class="px-5 py-4">
{% if candidat is null %}
    {# Aucun dossier paye en base : c'est le cas tant que les paiements viennent de
       l'ancien systeme (leurs dossiers ne sont pas dans ce module). #}
    <div class="rounded-lg border border-hairline bg-surface/50 px-4 py-6 text-center">
        <p class="text-sm font-semibold text-navy">Aucun dossier payé à confronter</p>
        <p class="mt-1 text-xs leading-relaxed text-ink/55">
            Le rapprochement compare cette écriture aux dossiers <strong>payés</strong> du module.
            Il n'y en a aucun pour l'instant : les paiements déjà partis ont été traités avant la bascule.
        </p>
    </div>
{% else %}
    {% set d = candidat.dossier %}
    {% set score = candidat.score %}
    {% set niveau = score >= 70 ? 'fort' : (score >= 40 ? 'moyen' : 'faible') %}
    {% set couleurs = {
        'fort':   {'texte': 'text-positive', 'fond': 'bg-positive', 'bord': 'border-positive/30', 'voile': 'bg-positive/10', 'libelle': 'Correspondance probable'},
        'moyen':  {'texte': 'text-amber-700', 'fond': 'bg-amber-500', 'bord': 'border-amber-500/30', 'voile': 'bg-amber-500/10', 'libelle': 'À vérifier'},
        'faible': {'texte': 'text-negative', 'fond': 'bg-negative', 'bord': 'border-negative/30', 'voile': 'bg-negative/10', 'libelle': 'Peu probable'}
    } %}
    {% set c = couleurs[niveau] %}

    {# Score : la jauge porte l'information, la couleur ne fait que la doubler. #}
    <div class="rounded-xl border {{ c.bord }} {{ c.voile }} px-4 py-3">
        <div class="flex items-baseline justify-between gap-3">
            <span class="text-xs font-semibold uppercase tracking-wider {{ c.texte }}">{{ c.libelle }}</span>
            <span class="text-2xl font-bold {{ c.texte }}">{{ score }}<span class="text-sm font-semibold text-ink/40">/100</span></span>
        </div>
        <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-white/70">
            <div class="h-full rounded-full {{ c.fond }} transition-all duration-500" style="width:{{ score }}%"></div>
        </div>
    </div>

    {# Le dossier candidat. #}
    <div class="mt-4 rounded-xl border border-hairline bg-white">
        <div class="flex items-center justify-between gap-3 border-b border-hairline px-4 py-2.5">
            <a href="{{ path('app_remboursement_dossier', {id: d.id}) }}" class="font-mono text-xs font-semibold text-navy hover:underline">{{ d.reference }}</a>
            {{ badges.badge(d.statut) }}
        </div>
        <dl class="divide-y divide-hairline text-sm">
            {% set champs = [
                {'k': 'Client',          'v': d.valideNom ?: d.controleNom ?: d.nomClient},
                {'k': 'Motif',           'v': d.motif.libelle},
                {'k': 'Montant',         'v': (d.valideMontant ?: d.controleMontant ?: d.montant)|number_format(2, ',', ' ') ~ ' €'},
                {'k': 'Établissement',   'v': d.etablissementCode},
                {'k': d.motif.value == 'rachat_sec' ? 'Immatriculation' : 'Code ICAR',
                 'v': d.motif.value == 'rachat_sec'
                        ? (d.valideImmatriculation ?: d.controleImmatriculation ?: d.immatriculation)
                        : (d.valideIcar ?: d.controleIcar ?: d.codeIcar)},
                {'k': 'Payé le',         'v': d.payeLe ? d.payeLe|date('d/m/Y') : null},
            ] %}
            {% for champ in champs %}
                <div class="flex items-baseline gap-3 px-4 py-2">
                    <dt class="w-32 shrink-0 text-[11px] font-semibold uppercase tracking-wider text-ink/45">{{ champ.k }}</dt>
                    <dd class="min-w-0 flex-1 text-ink">{{ champ.v ?: '—' }}</dd>
                </div>
            {% endfor %}
        </dl>
    </div>

    {# Ce qui a fait le score : la comptable doit pouvoir juger, pas faire confiance. #}
    <div class="mt-4">
        <h3 class="mb-2 text-[11px] font-bold uppercase tracking-wider text-ink/45">Signaux retenus</h3>
        {% if candidat.raisons is empty %}
            <p class="text-xs text-ink/55">Aucun signal commun : le score ne repose que sur l'absence d'incohérence.</p>
        {% else %}
            <ul class="space-y-1.5">
                {% for raison in candidat.raisons %}
                    <li class="flex items-start gap-2 text-xs text-ink">
                        <svg viewBox="0 0 24 24" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-positive" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        {{ raison }}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        <p class="mt-3 text-[11px] leading-relaxed text-ink/45">
            Comparé aux {{ nbPayes }} dossier{{ nbPayes > 1 ? 's' }} payé{{ nbPayes > 1 ? 's' }} du module.
            Le lettrage reste à faire en compta : cet écran ne modifie aucune écriture.
        </p>
    </div>
{% endif %}
</div>
