{% extends 'layout.html.twig' %}

{% block title %}{{ etab.libelle }} - Établissements{% endblock %}
{% block page_title %}Établissement {{ etab.codeEtab }}{% endblock %}

{% set input = 'w-full rounded-md border border-hairline bg-white px-2.5 py-1.5 text-sm text-ink transition focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/25' %}
{% set label = 'mb-1 block text-[11px] font-semibold uppercase tracking-wider text-ink/45' %}

{% block content %}
<div class="mx-auto max-w-3xl">

    {% for message in app.flashes('success') %}
        <div class="mb-3 rounded-md border border-positive/30 bg-positive/10 px-3 py-2 text-sm text-positive">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mb-3 rounded-md border border-negative/30 bg-negative/10 px-3 py-2 text-sm text-negative">{{ message }}</div>
    {% endfor %}

    <a href="{{ path('app_etablissements') }}" class="mb-3 inline-flex items-center gap-1 text-sm text-ink/55 transition hover:text-navy">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Tous les établissements
    </a>

    {# Carte etablissement #}
    <form method="post" action="{{ path('app_etablissements_maj', {code: etab.codeEtab}) }}" class="overflow-hidden rounded-xl border border-hairline bg-white shadow-sm">
        <input type="hidden" name="_token" value="{{ csrf_token('etab' ~ etab.codeEtab) }}">

        {# En-tete : nom + code + statut #}
        <div class="flex items-center justify-between gap-3 border-b border-hairline bg-surface/60 px-5 py-3">
            <div class="flex items-center gap-2.5">
                <span class="rounded-md bg-navy px-2 py-0.5 font-mono text-xs font-semibold text-white">{{ etab.codeEtab }}</span>
                <span class="text-base font-bold text-navy">{{ etab.libelle }}</span>
            </div>
            <label class="inline-flex cursor-pointer items-center gap-2 text-xs font-medium text-ink/70">
                <input type="checkbox" name="actif" value="1" {{ etab.actif ? 'checked' }} class="h-4 w-4 rounded border-hairline text-navy focus:ring-gold/30">
                Actif
            </label>
        </div>

        <div class="space-y-5 px-5 py-4">
            {# Identite #}
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div>
                    <label class="{{ label }}">Libellé</label>
                    <input type="text" name="libelle" value="{{ etab.libelle }}" class="{{ input }}">
                </div>
                <div>
                    <label class="{{ label }}">Société</label>
                    <input type="text" name="societe" value="{{ etab.societe ?: etab.codeSociete }}" class="{{ input }}">
                </div>
            </div>

            {# Coordonnees bancaires (debiteur SEPA) #}
            <div>
                <div class="mb-2 flex items-center gap-2">
                    <h2 class="text-[11px] font-bold uppercase tracking-wider text-navy">Coordonnées bancaires — débiteur SEPA</h2>
                    <span class="h-px flex-1 bg-hairline"></span>
                </div>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div class="sm:col-span-2">
                        <label class="{{ label }}">Nom légal (bénéficiaire SEPA)</label>
                        <input type="text" name="nom_legal_sepa" value="{{ etab.nomLegalSepa }}" placeholder="GROUPE SYNTHAUTO SYNTHAUTO CSP" class="{{ input }}">
                    </div>
                    <div>
                        <label class="{{ label }}">IBAN</label>
                        <input type="text" name="iban" value="{{ etab.iban }}" placeholder="FR76 …" class="{{ input }} font-mono">
                    </div>
                    <div>
                        <label class="{{ label }}">BIC</label>
                        <input type="text" name="bic" value="{{ etab.bic }}" placeholder="BNPAFRPP" class="{{ input }} font-mono">
                    </div>
                    <div>
                        <label class="{{ label }}">Banque</label>
                        <input type="text" name="banque" value="{{ etab.banque }}" placeholder="BNP Paribas" class="{{ input }}">
                    </div>
                    <div>
                        <label class="{{ label }}">Compte de contrepartie</label>
                        <input type="text" name="compte_contrepartie" value="{{ etab.compteContrepartie }}" placeholder="5120600" class="{{ input }} font-mono">
                    </div>
                </div>
            </div>
        </div>

        {# Pied : dernier passage + action #}
        <div class="flex items-center justify-between gap-3 border-t border-hairline bg-surface/40 px-5 py-2.5">
            <span class="text-[11px] text-ink/45">
                {% if etab.modifieLe %}Dernier passage : {{ etab.modifiePar ?: 'inconnu' }} · {{ etab.modifieLe|date('d/m/Y à H:i') }}{% else %}Jamais modifié{% endif %}
            </span>
            <button type="submit" class="rounded-md bg-navy px-4 py-1.5 text-sm font-medium text-white transition hover:bg-navy-deep">Enregistrer</button>
        </div>
    </form>

    {# Contacts e-mail #}
    <div class="mt-4 overflow-hidden rounded-xl border border-hairline bg-white shadow-sm">
        <div class="flex items-center justify-between gap-3 border-b border-hairline bg-surface/60 px-5 py-3">
            <h2 class="text-sm font-bold text-navy">Contacts e-mail</h2>
            <span class="text-[11px] text-ink/45">Destinataires des relances site</span>
        </div>

        <div class="px-5 py-4">
            {# Ajout #}
            <form method="post" action="{{ path('app_etablissements_contact_ajout', {code: etab.codeEtab}) }}" class="mb-3 flex flex-wrap items-center gap-2 rounded-md border border-dashed border-hairline bg-surface/50 p-2.5">
                <input type="hidden" name="_token" value="{{ csrf_token('contact' ~ etab.codeEtab) }}">
                <input type="email" name="email" required placeholder="prenom.nom@demonstration.invalid" class="min-w-0 flex-1 rounded-md border border-hairline bg-white px-2.5 py-1.5 text-sm text-ink focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/25">
                <select name="role" class="rounded-md border border-hairline bg-white px-2.5 py-1.5 text-sm text-ink">
                    {% for cle, libelle in roles %}<option value="{{ cle }}">{{ libelle }}</option>{% endfor %}
                </select>
                <button type="submit" class="rounded-md bg-navy px-3.5 py-1.5 text-sm font-medium text-white transition hover:bg-navy-deep">Ajouter</button>
            </form>

            {# Liste #}
            {% for c in contacts %}
                <div class="flex flex-wrap items-center gap-2 border-t border-hairline py-2.5">
                    <form method="post" action="{{ path('app_etablissements_contact_maj', {id: c.id}) }}" class="flex flex-1 flex-wrap items-center gap-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('contact-maj' ~ c.id) }}">
                        <input type="email" name="email" value="{{ c.email }}" required class="min-w-0 flex-1 rounded-md border border-hairline bg-white px-2.5 py-1.5 text-sm text-ink focus:border-gold focus:outline-none focus:ring-2 focus:ring-gold/25 {{ not c.actif ? 'opacity-50' }}">
                        <select name="role" class="rounded-md border border-hairline bg-white px-2.5 py-1.5 text-sm text-ink">
                            {% for cle, libelle in roles %}<option value="{{ cle }}" {{ c.role == cle ? 'selected' }}>{{ libelle }}</option>{% endfor %}
                        </select>
                        <label class="inline-flex items-center gap-1.5 text-xs text-ink/70">
                            <input type="checkbox" name="actif" value="1" {{ c.actif ? 'checked' }} class="h-4 w-4 rounded border-hairline text-navy focus:ring-gold/30">actif
                        </label>
                        <button type="submit" class="rounded-md border border-navy/25 px-3 py-1.5 text-xs font-semibold text-navy transition hover:bg-navy/5">Enregistrer</button>
                    </form>
                    <form method="post" action="{{ path('app_etablissements_contact_suppr', {id: c.id}) }}" onsubmit="return confirm('Supprimer ce contact ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('contact-suppr' ~ c.id) }}">
                        <button type="submit" class="rounded-md border border-negative/30 px-3 py-1.5 text-xs font-semibold text-negative transition hover:bg-negative/10">Supprimer</button>
                    </form>
                </div>
            {% else %}
                <p class="border-t border-hairline py-5 text-center text-sm text-ink/50">Aucun contact. Ajoutez le directeur et les secrétaires ci-dessus.</p>
            {% endfor %}
        </div>
    </div>

</div>
{% endblock %}
