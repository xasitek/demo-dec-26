{# La recherche transverse. Elle garde la file courante dans son formulaire :
   on cherche SANS perdre le travail en cours, et on y revient d'un clic.
   Un terme qui est un identifiant ne passe meme pas par ici -- le controleur
   saute directement au dossier. #}
<form method="get" action="{{ path('app_travail') }}" class="mt-3">
  <input type="hidden" name="file" value="{{ file }}">
  {% if filtres.etablissement_id|default('') %}
    <input type="hidden" name="etablissement_id" value="{{ filtres.etablissement_id }}">
  {% endif %}
  <div class="flex flex-wrap items-center gap-2">
    <div class="relative min-w-[22rem] flex-1">
      <input type="search" name="q" value="{{ q }}" autocomplete="off"
             placeholder="Client, code client, facture, montant, VIN, immatriculation, compte, établissement…"
             class="w-full rounded-xl border border-hairline bg-white px-3 py-2.5 pl-9 text-[13px]
                    shadow-sm focus:border-navy focus:outline-none">
      <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink/35">⌕</span>
    </div>
    <button type="submit"
            class="rounded-xl bg-navy px-4 py-2.5 text-[13px] font-semibold text-white hover:bg-navy-deep">
      Rechercher</button>
    {% if q %}
      <a href="{{ path('app_travail', filtres|merge({file: file})) }}"
         class="text-[12px] font-semibold text-navy hover:underline">Revenir à ma file</a>
    {% endif %}
  </div>
  <details class="mt-1">
    <summary class="cursor-pointer text-[11px] font-semibold text-navy">Ce que la recherche reconnaît ▾</summary>
    <div class="mt-1 grid gap-x-6 gap-y-0.5 rounded-lg border border-hairline bg-surface px-3 py-2
                text-[11.5px] leading-relaxed text-ink/65 sm:grid-cols-2">
      {% for quoi, exemple in champs_recherche %}
        <div><b>{{ quoi }}</b> — {{ exemple }}</div>
      {% endfor %}
    </div>
    <p class="mt-1 text-[11px] leading-relaxed text-ink/50">
      Un identifiant complet ouvre <b>directement le dossier</b> : tapez un numéro de facture et
      la créance s'ouvre, sans page de résultats intermédiaire. Les zéros de tête sont facultatifs.
    </p>
  </details>
</form>
