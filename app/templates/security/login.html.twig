{% extends 'base.html.twig' %}

{% block title %}Connexion - Finance Créances{% endblock %}

{% block body %}
<div class="auth">
    <section class="auth-showcase">
        <span class="showcase-grid" aria-hidden="true"></span>
        <span class="showcase-euro" aria-hidden="true">&euro;</span>
        <span class="shape shape-triangle" aria-hidden="true"></span>
        <span class="shape shape-arc" aria-hidden="true"></span>

        <div class="showcase-top">
            <img src="{{ asset('images/logo-fc-automobile-white.png') }}" alt="Groupe Synthauto" class="showcase-logo">
        </div>

        <div class="showcase-body">
            <p class="eyebrow">Finance &middot; Pilotage &middot; Groupe Synthauto</p>
            <h1 class="showcase-title">Centraliser.<br>Analyser.<br><span class="gold">Piloter.</span></h1>
            <p class="showcase-lead">
                Le cockpit financier du groupe : garanties, créances et rappels réunis
                au même endroit, suivis en temps réel.
            </p>

            <div class="demo-card">
                <div class="demo-head">
                    <span class="demo-label">Périmètre</span>
                    <span class="demo-tag">2026</span>
                </div>
                <ul class="demo-list">
                    <li class="en-cours"><span class="dot"></span>Garanties constructeur</li>
                    <li class="on"><span class="dot"></span>Remboursement client</li>
                    <li class="en-cours"><span class="dot"></span>Espace livraison</li>
                    <li class="en-cours"><span class="dot"></span>Autopilot</li>
                </ul>
            </div>
        </div>

        <div class="showcase-stats">
            <div><strong>1946</strong><span>Fondation</span></div>
            <div><strong>Multi</strong><span>Marques</span></div>
            <div><strong>FR &middot; CH</strong><span>France &amp; Suisse</span></div>
        </div>
    </section>

    <section class="auth-panel">
        <div class="auth-box">
            {% for message in app.flashes('auth_error') %}
                <p class="login-error" role="alert">{{ message }}</p>
            {% endfor %}

            <h2 class="auth-title">Bienvenue</h2>
            <p class="auth-sub">Connectez-vous pour accéder à votre cockpit financier.</p>

            <a href="{{ path('oauth_google_connect') }}" class="btn-google">
                <span class="g-badge">
                    <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                    </svg>
                </span>
                <span>Continuer avec Google</span>
            </a>

            <p class="auth-domain">Accès réservé aux comptes demonstration.invalid</p>

            <div class="auth-foot">
                <span>Connexion sécurisée</span>
                <span>v1</span>
            </div>
        </div>
    </section>
</div>
{% endblock %}
