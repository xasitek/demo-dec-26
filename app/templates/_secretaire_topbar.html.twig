{# Sous-navigation d'un espace du poste secretaire, dans la topbar.

   Meme grammaire que le poste comptable : la barre laterale porte les modules, la
   topbar porte les ecrans du module courant. Les onglets viennent de l'espace, donc
   un module qui ajoute un ecran n'a rien a modifier ici.

   Param : active (cle de l'item courant, ex. 'declarer').

   Un item marque `exigeConnexion` passe par la connexion Google et revient sur
   l'ecran demande : les formulaires de depot sont publics, mais le suivi personnel
   suppose de savoir qui depose. #}
{% set route = app.request.attributes.get('_route') %}
{% set espace = espace_secretaire(route) %}

{% if espace and espace.items|length > 1 %}
    <nav class="flex min-w-0 flex-1 items-center" data-controller="correction-badge">
        <div class="inline-flex shrink-0 rounded-md border border-hairline bg-white p-1">
            {% for item in espace.items %}
                {# Le badge est une fonction Twig nommee par l'espace. Twig ne sait pas
                   appeler une fonction par son nom : on resout les cas connus ici. #}
                {% set n = item.badge == 'remb_nb_correction' ? remb_nb_correction() : 0 %}
                {% set badge %}{% if item.badge %}<span data-correction-badge-target="compteur" title="Dossiers à corriger" class="ml-2 rounded-full bg-orange-500 px-1.5 text-xs font-bold text-white {{ n > 0 ? '' : 'hidden' }}">{{ n > 0 ? (n > 99 ? '99+' : n) : '' }}</span>{% endif %}{% endset %}

                {% if item.cle == active %}
                    <span class="inline-flex items-center rounded bg-navy px-3 py-1 text-sm font-medium text-white">{{ item.libelle }}{{ badge }}</span>
                {% else %}
                    {% set cible = item.exigeConnexion and not app.user
                        ? path('oauth_google_connect', { redirect: path(item.route), secretaire: 1 })
                        : path(item.route) %}
                    <a href="{{ cible }}" class="inline-flex items-center rounded px-3 py-1 text-sm font-medium text-ink/70 transition hover:text-navy">{{ item.libelle }}{{ badge }}</a>
                {% endif %}
            {% endfor %}
        </div>
    </nav>
{% endif %}
