{% set docs = {
    cgu: {
        verbe: "J'ai lu et j'accepte",
        label: "les Conditions générales d'utilisation",
        route: 'app_legal_cgu',
    },
    confidentialite: {
        verbe: 'J\'ai pris connaissance de',
        label: 'la Politique de confidentialité, dont le suivi d\'activité',
        route: 'app_legal_confidentialite',
    },
} %}
<div class="fixed inset-0 z-[100] flex items-center justify-center bg-navy-deep/70 p-4">
    <div class="w-full max-w-lg rounded-2xl bg-white p-6 shadow-2xl">
        <h2 class="text-lg font-bold text-navy">Avant de continuer</h2>
        <p class="mt-2 text-sm text-ink/70">Merci de prendre connaissance des documents suivants pour accéder à Finance Créances.</p>

        <form method="post" action="{{ path('app_legal_accepter') }}" class="mt-5 space-y-4">
            <input type="hidden" name="_token" value="{{ csrf_token('legal_accepter') }}">

            {% for doc in manquants %}
                {% set d = docs[doc] %}
                {% if d %}
                    <label class="flex items-start gap-3 text-sm text-ink">
                        <input type="checkbox" name="{{ doc }}" required class="mt-0.5 h-4 w-4 rounded border-ink/30 text-navy focus:ring-navy">
                        <span>{{ d.verbe }} <a href="{{ path(d.route) }}" target="_blank" rel="noopener" class="font-medium text-navy underline">{{ d.label }}</a>.</span>
                    </label>
                {% endif %}
            {% endfor %}

            <button type="submit" class="w-full rounded-lg bg-navy px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-navy-deep">Continuer</button>
        </form>

        <p class="mt-3 text-center text-xs text-ink/40">Votre acceptation est horodatée et conservée comme preuve d'information.</p>
    </div>
</div>
