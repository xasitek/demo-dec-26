{% extends 'emails/remboursement/_base.html.twig' %}

{% block accent %}#DC2626{% endblock %}
{% block titre %}Dossier refusé{% endblock %}

{% block contenu %}
    <p style="margin:0 0 16px;">Ce dossier de remboursement a été <strong style="color:#DC2626;">refusé</strong> par le service comptable.</p>

    {% include 'emails/remboursement/_infos.html.twig' %}

    <p style="margin:0 0 8px; font-size:11px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; color:#9096A5;">Message</p>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0;">
        <tr><td style="border-left:4px solid #DC2626; background:#FEF2F2; padding:14px 18px; font-size:14px; line-height:1.65; color:#3F3F46;">{{ message|nl2br }}</td></tr>
    </table>
{% endblock %}
