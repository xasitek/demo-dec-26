{% extends 'emails/remboursement/_base.html.twig' %}

{% block accent %}#EA580C{% endblock %}
{% block titre %}Vos dossiers en attente{% endblock %}

{# Ligne "pour info" (sans bouton). corr=true -> accent orange (action a faire),
   sinon gris (en attente du directeur, rien a faire). #}
{% macro ligne(d, corr) %}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 10px; border:1px solid {{ corr ? '#FBD7B5' : '#E3E3E8' }}; {{ corr ? 'border-left:4px solid #EA580C;' }} background:{{ corr ? '#FFF8F2' : '#FFFFFF' }};">
        <tr><td style="padding:12px 14px; line-height:1.4;">
            <span style="font-size:14px; font-weight:700; color:#2D3250;">{{ d.client }}</span>
            <span style="display:block; margin-top:3px; font-size:12px; color:#6B6F80;">{{ d.motif }} · {{ d.montant }} € · {{ d.cleLabel }} {{ d.cle ?: '—' }}</span>
            <span style="display:block; margin-top:2px; font-size:11px; color:#9096A5;">{{ d.reference }} · déposé le {{ d.depuis }}</span>
        </td></tr>
    </table>
{% endmacro %}

{% block contenu %}
    <p style="margin:0 0 6px;">Bonjour,</p>
    <p style="margin:0 0 20px;">Voici le point sur vos dossiers de remboursement ce matin.</p>

    {# Section 1 : corrections requises (action a faire, avec lien) #}
    {% if corrections is not empty %}
        <p style="margin:0 0 8px; font-size:11px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#C2410C;">Corrections requises ({{ corrections|length }})</p>
        {% for d in corrections %}{{ _self.ligne(d, true) }}{% endfor %}

        <table role="presentation" align="center" cellpadding="0" cellspacing="0" style="margin:16px auto 4px;"><tr>
            <td align="center">
                <a href="{{ lien_mes_dossiers }}" class="m-btn" style="display:inline-block; background:#2D3250; color:#FFFFFF; font-size:14px; font-weight:700; text-decoration:none; padding:12px 32px;">Corriger mes dossiers</a>
            </td>
        </tr></table>
    {% endif %}

    {# Section 2 : en attente du directeur (pour info, SANS bouton) #}
    {% if attente is not empty %}
        <p style="margin:26px 0 6px; font-size:11px; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; color:#9096A5;">En attente de validation du directeur ({{ attente|length }})</p>
        <p style="margin:0 0 12px; font-size:12px; line-height:1.55; color:#9096A5;">Ces dossiers ont été transmis au directeur concerné. Rien à faire de votre côté pour le moment.</p>
        {% for d in attente %}{{ _self.ligne(d, false) }}{% endfor %}
    {% endif %}
{% endblock %}
