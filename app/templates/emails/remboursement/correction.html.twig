{% extends 'emails/remboursement/_base.html.twig' %}

{% block accent %}#F59E0B{% endblock %}
{% block titre %}Correction demandée{% endblock %}

{% block contenu %}
    <p style="margin:0 0 16px;">Une <strong style="color:#B45309;">correction</strong> est nécessaire avant validation de ce dossier.</p>

    {% include 'emails/remboursement/_infos.html.twig' %}

    <p style="margin:0 0 8px; font-size:11px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; color:#9096A5;">Message</p>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 18px;">
        <tr><td style="border-left:4px solid #F59E0B; background:#FFFBEB; padding:14px 18px; font-size:14px; line-height:1.65; color:#3F3F46;">{{ message|nl2br }}</td></tr>
    </table>

    {% if documents is defined and documents is not empty %}
        <p style="margin:0 0 8px; font-size:11px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; color:#9096A5;">Documents à corriger</p>
        <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 20px;"><tr><td>
            {% for doc in documents %}
                <span style="display:inline-block; margin:0 6px 6px 0; background:#FFF7ED; border:1px solid #FED7AA; color:#B45309; padding:6px 12px; font-size:12px; font-weight:600;">{{ doc }}</span>
            {% endfor %}
        </td></tr></table>
    {% endif %}

    <table role="presentation" align="center" cellpadding="0" cellspacing="0" style="margin:10px auto 6px;"><tr>
        <td class="m-btn-td" align="center">
            <a href="{{ lien_edition }}" class="m-btn" style="display:inline-block; background:#F59E0B; color:#FFFFFF; font-size:14px; font-weight:700; text-decoration:none; padding:13px 30px;">Modifier mon dossier</a>
        </td>
    </tr></table>

    <p style="margin:14px 0 0; font-size:13px; color:#6B6F80; text-align:center;">Le lien ci-dessus ouvre directement votre dossier pour le corriger et le renvoyer.</p>
{% endblock %}
