{#- Bloc recapitulatif du dossier (2 colonnes, compact), commun aux 3 e-mails. Attend :
   reference, client, motif, cleLabel, cle, montant, dateDepot, dateActionLabel, dateAction. -#}
{%- set cellL = 'padding:10px 16px; border-bottom:1px solid #ECECF0; border-right:1px solid #ECECF0; vertical-align:top; width:50%;' -%}
{%- set cellR = 'padding:10px 16px; border-bottom:1px solid #ECECF0; vertical-align:top; width:50%;' -%}
{%- set lbl = 'display:block; font-size:10px; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; color:#9096A5; margin-bottom:3px;' -%}
{%- set val = 'display:block; font-size:13px; color:#2D3250; line-height:1.3; word-break:break-word;' -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:2px 0 20px; border:1px solid #ECECF0; border-collapse:collapse;">
    <tr>
        <td style="{{ cellL }}"><span style="{{ lbl }}">Référence</span><span style="{{ val }} font-family:'Courier New',monospace; font-weight:700;">{{ reference }}</span></td>
        <td style="{{ cellR }}"><span style="{{ lbl }}">Client</span><span style="{{ val }} font-weight:600;">{{ client }}</span></td>
    </tr>
    <tr>
        <td style="{{ cellL }}"><span style="{{ lbl }}">Motif</span><span style="{{ val }}">{{ motif }}</span></td>
        <td style="{{ cellR }}"><span style="{{ lbl }}">{{ cleLabel }}</span><span style="{{ val }} font-family:'Courier New',monospace;">{{ cle ?: '—' }}</span></td>
    </tr>
    <tr>
        <td style="{{ cellL }}"><span style="{{ lbl }}">Montant</span><span style="{{ val }} font-weight:700;">{{ montant }} €</span></td>
        <td style="{{ cellR }}"><span style="{{ lbl }}">Déposé le</span><span style="{{ val }}">{{ dateDepot }}</span></td>
    </tr>
    <tr>
        <td colspan="2" style="padding:10px 16px; vertical-align:top;"><span style="{{ lbl }}">{{ dateActionLabel }}</span><span style="{{ val }}">{{ dateAction }}</span></td>
    </tr>
</table>
