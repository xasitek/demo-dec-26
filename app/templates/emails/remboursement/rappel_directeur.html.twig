{% extends 'emails/remboursement/_base.html.twig' %}

{% block accent %}#16A34A{% endblock %}
{% block titre %}Dossiers à valider{% endblock %}

{# Ligne dossier : infos (gauche) | Refuser + Valider (droite), Voir les pieces (bas). #}
{% macro ligne(d) %}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 10px; border:1px solid #E3E3E8; background:#FFFFFF;">
        <tr><td style="padding:12px 14px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
                <td valign="top" style="line-height:1.35;">
                    <span style="font-size:14px; font-weight:700; color:#2D3250;">{{ d.client }}</span>
                    <span style="display:block; margin-top:3px; font-size:12px; color:#6B6F80;">{{ d.motif }} · {{ d.montant }} € · {{ d.cleLabel }} {{ d.cle ?: '—' }}</span>
                    {# Meme information que l'e-mail de validation : qui a depose. #}
                    {% if d.secretaire|default('') %}
                        <span style="display:block; margin-top:2px; font-size:12px; color:#9096A5;">Déposé par {{ d.secretaire }}</span>
                    {% endif %}
                </td>
                <td valign="top" align="right" style="white-space:nowrap; padding-left:12px;">
                    <a href="{{ d.lien_refuser }}" style="display:inline-block; margin-right:6px; background:#FFFFFF; color:#DC2626; border:1px solid #FCA5A5; font-size:12px; font-weight:700; text-decoration:none; padding:6px 13px;">Refuser</a>
                    <a href="{{ d.lien_valider }}" style="display:inline-block; background:#16A34A; color:#FFFFFF; font-size:12px; font-weight:700; text-decoration:none; padding:7px 15px;">Valider</a>
                </td>
            </tr></table>
            <a href="{{ d.lien_pieces }}" style="display:inline-block; margin-top:10px; font-size:12px; color:#2D3250; font-weight:600; text-decoration:underline;">Voir les pièces</a>
        </td></tr>
    </table>
{% endmacro %}

{% block contenu %}
    <p style="margin:0 0 6px;">Bonjour,</p>
    <p style="margin:0 0 20px;">Rappel : {{ pluriel(total, 'dossier contrôlé par la comptabilité attend', 'dossiers contrôlés par la comptabilité attendent') }} votre <strong style="color:#15803D;">validation</strong>. Consultez les pièces, puis validez ou refusez.</p>

    {% for d in dossiers %}{{ _self.ligne(d) }}{% endfor %}

    <table role="presentation" align="center" cellpadding="0" cellspacing="0" style="margin:18px auto 4px;"><tr>
        <td align="center">
            <a href="{{ lien_tout_valider }}" class="m-btn" style="display:inline-block; background:#16A34A; color:#FFFFFF; font-size:14px; font-weight:700; text-decoration:none; padding:12px 32px;">Tout valider</a>
        </td>
    </tr></table>
    <p style="margin:10px 0 0; font-size:12px; line-height:1.55; color:#9096A5; text-align:center;">Si vous refusez un dossier puis cliquez « Tout valider », le dossier refusé <strong>n'est pas modifié</strong>.</p>
{% endblock %}
