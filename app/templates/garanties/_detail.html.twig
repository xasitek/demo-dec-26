{% set ec = detail.ecriture %}
{% set ec_chassis = detail.ecritures_chassis %}
{% set ec_numor = detail.ecritures_numor %}
{% set dossiers = detail.dossiers %}

{% set tons = {
    'positive': 'bg-positive/10 text-positive',
    'negative': 'bg-negative/10 text-negative',
    'warning': 'bg-gold/15 text-gold-dark',
    'info': 'bg-navy/10 text-navy',
    'neutral': 'bg-surface text-ink/55'
} %}

{# Totaux pré-calculés pour les tfoot #}
{% set tot_dg_ht = 0 %}{% set tot_dg_ttc = 0 %}
{% for d in dossiers %}{% if d.montant_dg is not null %}{% set tot_dg_ht = tot_dg_ht + d.montant_dg %}{% set tot_dg_ttc = tot_dg_ttc + d.montant_dg * 1.20 %}{% endif %}{% endfor %}
{% set tot_chassis_init = 0 %}{% set tot_chassis_solde = 0 %}
{% for l in ec_chassis %}{% if l.montant_initial is not null %}{% set tot_chassis_init = tot_chassis_init + l.montant_initial %}{% endif %}{% if l.solde is not null %}{% set tot_chassis_solde = tot_chassis_solde + l.solde %}{% endif %}{% endfor %}
{% set tot_numor_init = 0 %}{% set tot_numor_solde = 0 %}
{% for l in ec_numor %}{% if l.montant_initial is not null %}{% set tot_numor_init = tot_numor_init + l.montant_initial %}{% endif %}{% if l.solde is not null %}{% set tot_numor_solde = tot_numor_solde + l.solde %}{% endif %}{% endfor %}

<div class="fc-detail">

    {# ============ EN-TÊTE : identité de la ligne Progiciel ============ #}
    <header class="fc-detail-identity">
        <div class="fc-detail-identity-main">
            <p class="fc-detail-vin">{{ ec.no_piece ?? '—' }}</p>
            <p class="fc-detail-identity-meta">
                <span>{{ ec.type_piece ?? '?' }}</span>
                <span class="sep">·</span>
                <span>{{ ec.date_piece ? ec.date_piece|date('d/m/Y') : '—' }}</span>
                {% if ec.chassis %}<span class="sep">·</span><span>VIN {{ ec.chassis }}</span>{% endif %}
                {% if ec.numor %}<span class="sep">·</span><span>OR {{ ec.numor }}</span>{% endif %}
            </p>
            {% if ec.libelle %}<p class="fc-detail-vin-complet">{{ ec.libelle }}</p>{% endif %}
        </div>
    </header>

    {# ============ HERO : montant de la ligne ============ #}
    <section class="fc-detail-hero">
        <p class="fc-detail-hero-label">Montant de cette écriture</p>
        <p class="fc-detail-hero-value">
            {% if ec.solde is not null %}
                {{ ec.solde|number_format(2, ',', ' ') }} <span class="fc-detail-hero-cur">€</span>
            {% else %}<span class="text-ink/35">—</span>{% endif %}
        </p>
        <p class="fc-detail-hero-sub">
            <span>Initial : {{ ec.montant_initial is not null ? (ec.montant_initial|number_format(2, ',', ' ') ~ ' €') : '—' }}</span>
            {% if ec.debit is not null and ec.debit > 0 %}<span class="sep">·</span><span>Débit {{ ec.debit|number_format(2, ',', ' ') }} €</span>{% endif %}
            {% if ec.credit is not null and ec.credit > 0 %}<span class="sep">·</span><span>Crédit {{ ec.credit|number_format(2, ',', ' ') }} €</span>{% endif %}
        </p>
    </section>

    {# ============ INFOS ÉCRITURE ============ #}
    <section class="fc-detail-grid">
        <div class="fc-detail-field fc-detail-field-strong">
            <p class="fc-detail-field-label">Concession (Code entité)</p>
            <p class="fc-detail-field-value">{{ ec.concession_sage ?? '—' }}</p>
        </div>
        <div class="fc-detail-field fc-detail-field-strong">
            <p class="fc-detail-field-label">Établissement</p>
            <p class="fc-detail-field-value">{{ ec.etablissement_sage ?? '—' }}</p>
        </div>
        <div class="fc-detail-field">
            <p class="fc-detail-field-label">Marque (BU)</p>
            <p class="fc-detail-field-value">{{ ec.marque_sage ?? '—' }}</p>
        </div>
        <div class="fc-detail-field">
            <p class="fc-detail-field-label">Payeur</p>
            <p class="fc-detail-field-value">{{ ec.payeur_sage ?? '—' }}</p>
        </div>
        <div class="fc-detail-field">
            <p class="fc-detail-field-label">VIN complet</p>
            <p class="fc-detail-field-value mono text-sm">{{ ec.vin_complet ?? '—' }}</p>
        </div>
        <div class="fc-detail-field">
            <p class="fc-detail-field-label">Solde chassis (net)</p>
            <p class="fc-detail-field-value">{{ ec.solde_chassis_net is not null ? (ec.solde_chassis_net|number_format(2, ',', ' ') ~ ' €') : '—' }}</p>
        </div>
    </section>

    {# ============ DG MATCHÉES ============ #}
    {% if dossiers is not empty %}
        <section class="fc-detail-section">
            <div class="fc-detail-section-head">
                <h3 class="fc-detail-section-title">DG associées</h3>
                <span class="fc-detail-section-meta">{{ pluriel(dossiers|length, 'DG matchée', 'DG matchées') }} (par chassis ou par OR)</span>
            </div>
            <div class="fc-detail-table-wrap">
                <table class="fc-detail-table">
                    <thead>
                        <tr>
                            <th>N° DG</th>
                            <th>MVS</th>
                            <th>OR</th>
                            <th>Concession portail</th>
                            <th>Statut</th>
                            <th class="is-num">Montant HT</th>
                            <th class="is-num">Soit TTC</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for d in dossiers %}
                            {% set sm = statut_meta[d.statut_code] ?? null %}
                            <tr>
                                <td><span class="mono">{{ d.num_dg ?? '—' }}</span></td>
                                <td><span class="mono text-xs">{{ d.mvs ?? '—' }}</span></td>
                                <td><span class="mono text-xs">{{ d.numero_or ?? '—' }}</span></td>
                                <td>{{ d.concession ?? '—' }}</td>
                                <td>{% if sm %}{{ d.statut_code }} {{ sm.libelle }}{% else %}{{ d.statut_code ?? '—' }}{% endif %}</td>
                                <td class="is-num">{{ d.montant_dg is not null ? (d.montant_dg|number_format(2, ',', ' ') ~ ' €') : '—' }}</td>
                                <td class="is-num is-strong">{{ d.montant_dg is not null ? ((d.montant_dg * 1.20)|number_format(2, ',', ' ') ~ ' €') : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr class="fc-detail-table-total">
                            <td colspan="5" class="fc-detail-table-total-label">Total</td>
                            <td class="is-num">{{ tot_dg_ht|number_format(2, ',', ' ') }} €</td>
                            <td class="is-num is-strong">{{ tot_dg_ttc|number_format(2, ',', ' ') }} €</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>
    {% endif %}

    {# ============ DOCUMENTS CONSTRUCTEUR (PDF) ============ #}
    {% if documents is defined and documents is not empty %}
        <section class="fc-detail-section">
            <div class="fc-detail-section-head">
                <h3 class="fc-detail-section-title">Documents</h3>
                <span class="fc-detail-section-meta">{{ pluriel(documents|length, 'document constructeur', 'documents constructeur') }}</span>
            </div>
            <div class="fc-detail-table-wrap">
                <table class="fc-detail-table">
                    <thead>
                        <tr>
                            <th>Document</th>
                            <th>Période couverte</th>
                            <th class="is-num">Taille</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for doc in documents %}
                            <tr>
                                <td><span class="mono text-xs">{{ doc.nom_fichier ?? doc.reference }}</span></td>
                                <td>
                                    {% if doc.periode_debut and doc.periode_fin %}
                                        {{ doc.periode_debut|date('d/m/Y') }} – {{ doc.periode_fin|date('d/m/Y') }}
                                    {% else %}—{% endif %}
                                </td>
                                <td class="is-num">{{ doc.taille ? (doc.taille // 1024) ~ ' Ko' : '—' }}</td>
                                <td class="is-num">
                                    <a class="fc-detail-doc-link" href="{{ path('app_garanties_document', { id: doc.id }) }}" target="_blank" rel="noopener">
                                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                                        Ouvrir
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}

    {# ============ TOUTES LES ÉCRITURES DU MÊME CHASSIS ============ #}
    {% if ec_chassis is not empty %}
        <section class="fc-detail-section">
            <div class="fc-detail-section-head">
                <h3 class="fc-detail-section-title">Écritures Progiciel de ce véhicule</h3>
                <span class="fc-detail-section-meta">{{ pluriel(ec_chassis|length, 'écriture', 'écritures') }} sur le compte 4116000</span>
            </div>
            <div class="fc-detail-table-wrap">
                <table class="fc-detail-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Pièce</th>
                            <th>Type</th>
                            <th>Libellé</th>
                            <th>Payeur</th>
                            <th>OR</th>
                            <th class="is-num">Montant initial</th>
                            <th class="is-num">Solde</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for l in ec_chassis %}
                            <tr>
                                <td>{{ l.date_piece ? l.date_piece|date('d/m/Y') : '—' }}</td>
                                <td><span class="mono text-xs">{{ l.no_piece ?? '—' }}</span></td>
                                <td><span class="mono text-xs">{{ l.type_piece ?? '—' }}</span></td>
                                <td>{{ l.libelle ?? '—' }}</td>
                                <td class="text-xs">{{ l.payeur ?? '—' }}</td>
                                <td class="mono text-xs">{{ l.numor ?? '—' }}</td>
                                <td class="is-num">{{ l.montant_initial is not null ? (l.montant_initial|number_format(2, ',', ' ') ~ ' €') : '—' }}</td>
                                <td class="is-num is-strong">{{ l.solde is not null ? (l.solde|number_format(2, ',', ' ') ~ ' €') : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr class="fc-detail-table-total">
                            <td colspan="6" class="fc-detail-table-total-label">Total</td>
                            <td class="is-num">{{ tot_chassis_init|number_format(2, ',', ' ') }} €</td>
                            <td class="is-num is-strong">{{ tot_chassis_solde|number_format(2, ',', ' ') }} €</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>
    {% endif %}

    {# ============ ÉCRITURES DU MÊME OR (utile pour OD globales) ============ #}
    {% if ec_numor is not empty and ec_numor|length > 1 %}
        <section class="fc-detail-section">
            <div class="fc-detail-section-head">
                <h3 class="fc-detail-section-title">Autres écritures avec le même OR</h3>
                <span class="fc-detail-section-meta">{{ ec.numor }} — {{ pluriel(ec_numor|length, 'écriture', 'écritures') }}</span>
            </div>
            <div class="fc-detail-table-wrap">
                <table class="fc-detail-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Pièce</th>
                            <th>Type</th>
                            <th>VIN</th>
                            <th>Libellé</th>
                            <th class="is-num">Montant initial</th>
                            <th class="is-num">Solde</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for l in ec_numor %}
                            <tr>
                                <td>{{ l.date_piece ? l.date_piece|date('d/m/Y') : '—' }}</td>
                                <td><span class="mono text-xs">{{ l.no_piece ?? '—' }}</span></td>
                                <td><span class="mono text-xs">{{ l.type_piece ?? '—' }}</span></td>
                                <td><span class="mono text-xs">{{ l.numvin ?? '—' }}</span></td>
                                <td>{{ l.libelle ?? '—' }}</td>
                                <td class="is-num">{{ l.montant_initial is not null ? (l.montant_initial|number_format(2, ',', ' ') ~ ' €') : '—' }}</td>
                                <td class="is-num is-strong">{{ l.solde is not null ? (l.solde|number_format(2, ',', ' ') ~ ' €') : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr class="fc-detail-table-total">
                            <td colspan="5" class="fc-detail-table-total-label">Total</td>
                            <td class="is-num">{{ tot_numor_init|number_format(2, ',', ' ') }} €</td>
                            <td class="is-num is-strong">{{ tot_numor_solde|number_format(2, ',', ' ') }} €</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>
    {% endif %}

    {# ============ COMMENTAIRES ============ #}
    {# Aucune condition sur la presence d'une DG : depuis l'ajout de l'ancrage sur
       l'ecriture, une ligne orpheline est commentable elle aussi. L'ancrage retenu est
       calcule par le controleur. #}
    <details class="fc-detail-notes-collapsible"
             data-controller="details-scroll"
             data-action="toggle->details-scroll#onToggle"
             {{ notes is not empty ? 'open' }}>
        <summary class="fc-detail-notes-trigger">
            <span class="fc-detail-notes-trigger-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </span>
            <span class="fc-detail-notes-trigger-label">
                <span class="fc-detail-notes-trigger-title">Notes &amp; commentaires</span>
                <span class="fc-detail-notes-trigger-count">{{ notes is empty ? 'Aucun commentaire · cliquer pour en ajouter' : pluriel(notes|length, 'commentaire', 'commentaires') }}</span>
            </span>
            <svg class="fc-detail-notes-trigger-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </summary>
        <div class="fc-detail-notes-content">
            {% include 'garanties/_notes.html.twig' with { ancre: ancre, notes: notes } only %}
        </div>
    </details>
</div>
