{#
    Email de relance GROUPÉ : un seul mail au vendeur (ou à la secrétaire) qui
    liste tous SES dossiers en correction côté ASP.
#}
{% set role_label = type == 'vendeur' ? 'vendeur' : 'secrétaire' %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Relance dossiers bonus écologique en correction</title>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #2D3250; margin: 0; padding: 12px 8px;">

    <p>Bonjour{% if destinataire_nom %} {{ destinataire_nom }}{% endif %},</p>

    <p>
        Voici la liste des dossiers de <strong>bonus écologique</strong> qui sont en
        <strong>correction côté ASP</strong> et dont vous êtes le/la {{ role_label }} ({{ ecritures|length }} {{ ecritures|length > 1 ? 'dossiers' : 'dossier' }}).
        Merci de les régulariser dès que possible sur le portail ASP.
    </p>

    <table cellpadding="6" cellspacing="0" style="border-collapse: collapse; margin: 16px 0; font-size: 13px; width: 100%; border: 1px solid #e5e7eb;">
        <thead style="background: #f5f5f7; text-transform: uppercase; font-size: 11px; color: #6b6f80; letter-spacing: 0.05em;">
            <tr>
                <th align="left" style="padding: 8px; border-bottom: 1px solid #e5e7eb;">Concession</th>
                <th align="left" style="padding: 8px; border-bottom: 1px solid #e5e7eb;">Date</th>
                <th align="left" style="padding: 8px; border-bottom: 1px solid #e5e7eb;">N° pièce</th>
                <th align="left" style="padding: 8px; border-bottom: 1px solid #e5e7eb;">Véhicule</th>
                <th align="left" style="padding: 8px; border-bottom: 1px solid #e5e7eb;">VIN</th>
                <th align="left" style="padding: 8px; border-bottom: 1px solid #e5e7eb;">Client</th>
                <th align="right" style="padding: 8px; border-bottom: 1px solid #e5e7eb;">Montant</th>
                <th align="left" style="padding: 8px; border-bottom: 1px solid #e5e7eb;">Retard</th>
            </tr>
        </thead>
        <tbody>
            {% for ec in ecritures %}
                <tr style="border-bottom: 1px solid #f0f1f4;">
                    <td style="padding: 8px;">{{ ec.codeetab ?? '—' }}</td>
                    <td style="padding: 8px;">{{ ec.dateecriture ? ec.dateecriture|date('d/m/Y') : '—' }}</td>
                    <td style="padding: 8px; font-family: monospace;">{{ ec.numpiece ?? '—' }}</td>
                    <td style="padding: 8px;">{{ (ec.marque ?? '')|trim }} {{ ec.modele ?? '' }}{% if ec.numimmat %} · {{ ec.numimmat }}{% endif %}</td>
                    <td style="padding: 8px; font-family: monospace; font-size: 12px;">{{ ec.numvin ?? '—' }}</td>
                    <td style="padding: 8px;">{{ ec.nom ?? '—' }}</td>
                    <td style="padding: 8px; text-align: right;">{{ ec.montant_signe is not null ? (ec.montant_signe|number_format(2, ',', ' ') ~ ' €') : '—' }}</td>
                    <td style="padding: 8px;{% if ec.retard %} color: #c97b1f; font-weight: bold;{% endif %}">{{ ec.retard ?? '' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <p>Merci d'avance,</p>
    <p style="color: #6b6f80; font-size: 13px;">
        <strong>Copilote - Finance Créances</strong>
    </p>

</body>
</html>
