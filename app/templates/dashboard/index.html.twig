{% extends 'layout.html.twig' %}

{% block title %}Tableau de bord - Finance Créances{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% block content %}
<div class="mx-auto max-w-6xl">
    <div class="mb-8">
        <h2 class="text-2xl font-bold text-navy">Bonjour {{ app.user.firstName }}.</h2>
        <p class="mt-1 text-ink">Bienvenue sur le cockpit financier du groupe Synthauto.</p>
        {% if derniere_maj_sage %}
            <p class="mt-2 inline-flex items-center gap-1.5 text-xs text-ink/50">
                <span class="h-1.5 w-1.5 rounded-full bg-positive"></span>
                Données Progiciel à jour au {{ derniere_maj_sage|date('d/m/Y à H\\hi', 'Europe/Paris') }}
            </p>
        {% endif %}
    </div>

    <div class="flex flex-col items-center justify-center rounded-2xl border border-hairline bg-white px-6 py-20 text-center">
        <span class="mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-navy text-gold">
            <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.3 6.2a4.55 4.55 0 0 0 5.4 0"/>
                <path d="M7.9 10.7c.9.8 2.4 1.3 4.1 1.3s3.2-.5 4.1-1.3"/>
                <path d="M13.9 3.5a1.93 1.93 0 0 0-3.8-.1l-3 10c-.1.2-.1.4-.1.6 0 1.7 2.7 3 6 3s6-1.3 6-3c0-.2 0-.4-.1-.6Z"/>
                <path d="M5.7 17c-1 .3-1.7.8-1.7 1.5 0 1.4 3.6 2.5 8 2.5s8-1.1 8-2.5c0-.6-.7-1.2-1.7-1.5"/>
            </svg>
        </span>
        <h3 class="text-xl font-bold text-navy">En construction</h3>
        <p class="mt-2 max-w-md text-sm text-ink/60">
            La plateforme se construit progressivement. Cette page évoluera au fil des modules mis en ligne.
        </p>
        <span class="mt-6 h-1 w-16 rounded-full bg-gold/70"></span>
    </div>
</div>
{% endblock %}
